<Project>
    <PropertyGroup>
        <netlib>10.0.14</netlib>
        <netlatest>net10.0</netlatest>

        <LangVersion>14</LangVersion>
        <Version>0.8.0</Version>
        <AssemblyVersion>11.0.0.0</AssemblyVersion>
        <AssemblyFileVersion>11.0.0.0</AssemblyFileVersion>
        <FileVersion>11.0.0.0</FileVersion>
        <Authors>webForCore contributors; Simon Jakob Egli (WebFormsForCore)</Authors>
        <Company>Estrellas de Esperanza</Company>
        <Copyright>Copyright (c) Simon Jakob Egli and webForCore contributors. Portions copyright (c) Microsoft Corporation, the .NET Foundation and others; see NOTICE.</Copyright>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <PackageProjectUrl>https://github.com/xforcore/webForCore</PackageProjectUrl>
        <RepositoryUrl>https://github.com/xforcore/webForCore</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>

        <!-- System.Drawing and System.Drawing.Common: drawingForCore's packages (https://github.com/xforcore/drawingForCore,
             feed in nuget.config). -p:DrawingForCoreSource=<checkout> builds a local checkout's projects instead
             (Directory.Build.targets). -->
        <DrawingForCoreVersion>0.3.0</DrawingForCoreVersion>
    </PropertyGroup>

    <!-- webForCore: a package's licence follows its code's origin (NOTICE). Lifted ASP.NET Web Stack, Katana and SignalR
         projects are Apache-2.0; ASP.NET Identity is MIT, as is WebFormsForCore's own code. -->
    <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('webForCore.')) And !$(MSBuildProjectName.StartsWith('webForCore.Microsoft.AspNet.Identity'))">
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    </PropertyGroup>
</Project>