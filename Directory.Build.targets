<Project>
  <!-- webForCore: -p:DrawingForCoreSource=<drawingForCore checkout> builds against that checkout's projects instead of
       the drawingForCore packages, to try a System.Drawing change in webForCore before it is released. Each package
       reference becomes a reference to its project, keeping its metadata (Aliases). -->
  <ItemGroup Condition="'$(DrawingForCoreSource)' != ''">
    <_DrawingForCorePackage Include="@(PackageReference->WithMetadataValue('Identity', 'drawingForCore'))" DrawingForCoreProject="$(DrawingForCoreSource)/src/drawingForCore.System.Drawing/drawingForCore.System.Drawing.csproj" />
    <_DrawingForCorePackage Include="@(PackageReference->WithMetadataValue('Identity', 'drawingForCore.Common'))" DrawingForCoreProject="$(DrawingForCoreSource)/src/drawingForCore.System.Drawing.Common/drawingForCore.System.Drawing.Common.csproj" />
    <ProjectReference Include="@(_DrawingForCorePackage->'%(DrawingForCoreProject)')" RemoveMetadata="DrawingForCoreProject;Version" />
    <PackageReference Remove="@(_DrawingForCorePackage)" />
  </ItemGroup>

  <!-- webForCore: the fork's System.Web contains Microsoft's System.Web.HttpUtility (as on .NET Framework). The shared
       framework also has a System.Web.HttpUtility.dll with a System.Web.HttpUtility type, so in projects that reference
       the fork's System.Web the compiler would see two (CS0433). Drop the framework copy there, as the projects already
       drop the framework's System.Web.dll facade. Projects without the fork's System.Web keep .NET's HttpUtility.
       src/webForCore.WebStack.targets defines the same target for applications (and the webForCore.Web package's
       buildTransitive targets); keep the two in step (issue #7). -->
  <Target Name="WebForCoreDropFrameworkHttpUtility" AfterTargets="ResolveAssemblyReferences" BeforeTargets="FindReferenceAssembliesForReferences" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <!-- Only this repository's System.Web (a project reference); upstream's NuGet WebFormsForCore.Web still forwards
           HttpUtility to .NET's, so projects that use that package (WebFormsForCore.Build) keep .NET's HttpUtility. -->
      <_WebForCoreSystemWeb Include="@(ReferencePath)" Condition="'%(FileName)' == 'System.Web' AND '%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference'" />
    </ItemGroup>
    <PropertyGroup>
      <_WebForCoreHasSystemWeb Condition="'@(_WebForCoreSystemWeb)' != ''">true</_WebForCoreHasSystemWeb>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WebForCoreHasSystemWeb)' == 'true'">
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'System.Web.HttpUtility' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(FullPath),'(?i)[\\/]Microsoft\.(NETCore|AspNetCore)\.App\.Ref[\\/]'))" />
    </ItemGroup>
  </Target>
  <!-- webForCore: Microsoft's assembly identity (#141). A project that replaces a Microsoft assembly whose version isn't
       webForCore's 11.0.0.0 sets MicrosoftAssemblyVersion to Microsoft's: the version libraries built against Microsoft's
       assembly reference (BundleTransformer: System.Web.Optimization 1.1.0.0, CS0012 against 11.0.0.0). It takes the place
       of src/VersionInfo.cs, and of the Web Stack's development versions in CommonAssemblyInfo.cs, which Microsoft's own
       builds replaced with the released version (BUILD_GENERATED_VERSION). tools/ci/check_assembly_identities.cs checks
       every packaged assembly against Microsoft's. -->
  <PropertyGroup Condition="'$(MicrosoftAssemblyVersion)' != ''">
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>$(MicrosoftAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(MicrosoftAssemblyVersion)</FileVersion>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    <DefineConstants>$(DefineConstants);BUILD_GENERATED_VERSION</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(MicrosoftAssemblyVersion)' != ''">
    <Compile Remove="$(MSBuildThisFileDirectory)src/VersionInfo.cs" />
  </ItemGroup>
</Project>
