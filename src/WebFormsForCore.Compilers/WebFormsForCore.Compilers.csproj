<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net11.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <DebugType>portable</DebugType>
        <AssemblyName>WebFormsForCore.Compilers</AssemblyName>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        
        <PackageId>webForCore.Compilers</PackageId>
        <Title>WebFormsForCore.Compilers</Title>
        <Product>WebFormsForCore.Compilers</Product>
        <Description>WebFormsForCore.Compilers for webForCore: ASP.NET 4.x applications (Web Forms, MVC 5, Web API 2) on .NET 11 and Kestrel.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net11</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net11.0'">
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="Roslyn.net11.0\**\*.*">
            <!--<Link>Compilers\%(RecursiveDir)%(Filename)%(Extension)</Link>-->
            <Pack>True</Pack>
            <PackagePath>lib\net11.0</PackagePath>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <Compile Include="..\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
    </ItemGroup>

    
    <Target Name="CopyCompilersNoTools" BeforeTargets="ResolveReferences" Condition="$(TargetFramework) != 'net48'">
        <ItemGroup>
            <CompilerItems Include="Roslyn.$(TargetFramework)\**\*.*" />
        </ItemGroup>

        <Message Text="Roslyn.$(TargetFramework)" Importance="high" />
        <Copy SourceFiles="@(CompilerItems)" DestinationFiles="@(CompilerItems->'$(OutputPath)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>

</Project>
