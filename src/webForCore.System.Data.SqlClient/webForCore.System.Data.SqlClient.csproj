  <!-- SR's properties from Strings.resx, as the Arcade SDK's GenerateResxSource writes them for upstream
       (GenerateResxSourceOmitGetResourceString: SR.cs has GetResourceString). -->
  <UsingTask TaskName="WebForCoreGenerateSR" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ResxFile ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var code = new StringBuilder();
        code.Append("// <auto-generated/>\n");
        code.Append("namespace FxResources.System.Data.SqlClient { internal static class SR { } }\n");
        code.Append("namespace System\n{\n    internal static partial class SR\n    {\n");
        code.Append("        private static global::System.Resources.ResourceManager s_resourceManager;\n");
        code.Append("        internal static global::System.Resources.ResourceManager ResourceManager => s_resourceManager ?? (s_resourceManager = new global::System.Resources.ResourceManager(typeof(FxResources.System.Data.SqlClient.SR)));\n");
        foreach (var data in XDocument.Load(ResxFile).Root.Elements("data"))
        {
            string name = (string)data.Attribute("name");
            code.Append("        internal static string @" + name + " => GetResourceString(\"" + name + "\");\n");
        }
        code.Append("    }\n}\n");
        string text = code.ToString();
        if (!File.Exists(OutputFile) || File.ReadAllText(OutputFile) != text)
        {
            Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
            File.WriteAllText(OutputFile, text);
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WebForCoreGenerateSR" BeforeTargets="CoreCompile" Inputs="$(MpSrc)Resources/Strings.resx" Outputs="$(IntermediateOutputPath)SR.g.cs">
    <WebForCoreGenerateSR ResxFile="$(MpSrc)Resources/Strings.resx" OutputFile="$(IntermediateOutputPath)SR.g.cs" />
  </Target>
  <ItemGroup>
