  <Target Name="WebForCoreBuildOtherSqlClientPlatform" AfterTargets="Build" Condition="'$(_SqlClientOtherPlatformBuild)' != 'true' AND '$(DesignTimeBuild)' != 'true' AND '$(BuildingInsideVisualStudio)' != 'true'">
