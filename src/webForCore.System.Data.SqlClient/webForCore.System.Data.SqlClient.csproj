<Project Sdk="Microsoft.NET.Sdk">

  <!-- From dotnet/maintenance-packages e699209 (System.Data.SqlClient 4.9.1) by way of the external/maintenance-packages
       submodule (xforcore/maintenance-packages' webforcore branch, #41). MIT licence; see NOTICE at the repo root.
       Microsoft's package has a windows and a unix build of the assembly (runtimes/win and runtimes/unix); this project
       builds the one for the platform it builds on, which the projects that reference it use, and then the other, for the
       package. -p:SqlClientPlatform=windows|unix chooses. -->
  <PropertyGroup>
    <SqlClientPlatform Condition="'$(SqlClientPlatform)' == '' AND $([MSBuild]::IsOSPlatform('Windows'))">windows</SqlClientPlatform>
    <SqlClientPlatform Condition="'$(SqlClientPlatform)' == ''">unix</SqlClientPlatform>
    <_SqlClientOtherPlatform Condition="'$(SqlClientPlatform)' == 'windows'">unix</_SqlClientOtherPlatform>
    <_SqlClientOtherPlatform Condition="'$(SqlClientPlatform)' != 'windows'">windows</_SqlClientOtherPlatform>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/$(SqlClientPlatform)/</IntermediateOutputPath>
    <OutputPath>bin/$(Configuration)/$(SqlClientPlatform)/</OutputPath>

    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Data.SqlClient</AssemblyName>
    <RootNamespace>System.Data.SqlClient</RootNamespace>
    <PackageId>webForCore.Data.SqlClient</PackageId>
    <Description>System.Data.SqlClient</Description>
    <PackageDescription>System.Data.SqlClient for webForCore: Microsoft's System.Data.SqlClient 4.9.1 (dotnet/maintenance-packages), with Assembly.GetTypes() fixed on .NET 8 and later (#41). Replaces the System.Data.SqlClient package in applications that use webForCore.</PackageDescription>
    <PackageTags>webforms;aspnet;sqlclient;porting;net10</PackageTags>
    <!-- Microsoft's code; MIT, as in dotnet/maintenance-packages (Directory.Build.props makes webForCore.* Apache-2.0). -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Microsoft's identity: the assembly version of the package's .NET builds, and Microsoft's public key
         (PublicKeyToken=b03f5f7f11d50a3a, FakeStrongName below). -->
    <AssemblyVersion>4.6.1.6</AssemblyVersion>
    <!-- Above Microsoft's 4.9.1 (4.900.126.11103), so that this build wins wherever file versions decide. -->
    <FileVersion>4.901.0.0</FileVersion>
    <InformationalVersion>4.9.1+webForCore</InformationalVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>../SigningKey/WebFormsForCore.snk</AssemblyOriginatorKeyFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Upstream's list; CA1416, as upstream's windows and unix builds are -windows and -unix target frameworks; CA2022,
         which the .NET 10 SDK's analyzers added. -->
    <NoWarn>$(NoWarn);CA1001;CA1068;CA1069;CA1309;CA1310;CA1419;CA1510;CA1711;CA1805;CA1806;CA1816;CA1822;CA1830;CA1834;CA1835;CA1836;CA1840;CA1844;CA1852;CA1853;CA1854;CA1859;CA1863;CA2016;CA2020;CA2101;CA2200;CA2201;CA2208;CA2219;CA2249;CA2251;CA5366;CS0168;CS0618;CS0649;CS0672;IDE0073;SYSLIB0004;SYSLIB0051;nullable;CA1416;CS1591;CA2022</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <!-- The assembly's company, product and copyright are Microsoft's (below); the package's are webForCore's. -->
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyCopyrightAttribute>false</GenerateAssemblyCopyrightAttribute>

    <!-- The package is laid out as Microsoft's: lib/ (the unix build, for compiling), runtimes/unix/lib/ and
         runtimes/win/lib/ (WebForCoreSqlClientPackageFiles below). -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);WebForCoreSqlClientPackageFiles</TargetsForTfmSpecificContentInPackage>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <MpSrc>../../external/maintenance-packages/src/System.Data.SqlClient/src/</MpSrc>
    <MpCommon>../../external/maintenance-packages/src/Common/</MpCommon>
  </PropertyGroup>

  <!-- The assembly attributes of upstream's builds (its Directory.Build.props and .targets and the Arcade SDK), but for
       SupportedOSPlatform("Windows"/"unix"), which its -windows and -unix target frameworks add: here the unix build is
       also the package's compile reference (upstream's is a build without the attribute), and with it every call into
       SqlClient would be a CA1416 warning. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyCompanyAttribute"><_Parameter1>Microsoft Corporation</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyProductAttribute"><_Parameter1>Microsoft® .NET</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyCopyrightAttribute"><_Parameter1>© Microsoft Corporation. All rights reserved.</_Parameter1></AssemblyAttribute>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyDefaultAliasAttribute">
      <_Parameter1>System.Data.SqlClient</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Resources.NeutralResourcesLanguageAttribute">
      <_Parameter1>en-US</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.DefaultDllImportSearchPathsAttribute">
      <_Parameter1>System.Runtime.InteropServices.DllImportSearchPath.AssemblyDirectory | System.Runtime.InteropServices.DllImportSearchPath.System32</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
    <AssemblyMetadata Include="PreferInbox" Value="True" />
    <AssemblyMetadata Include="Serviceable" Value="True" />
  </ItemGroup>

