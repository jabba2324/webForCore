<Project Sdk="Microsoft.NET.Sdk">

  <!-- From aspnet/AspNetWebStack 2106565 (System.Web.WebPages.Razor) by way of the external/AspNetWebStack submodule (xforcore/AspNetWebStack's webforcore branch, #61).
       Apache License 2.0; see LICENSE-APACHE-2.0.txt and NOTICE at the repo root. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Web.WebPages.Razor</AssemblyName>
    <RootNamespace>System.Web.WebPages.Razor</RootNamespace>
    <PackageId>webForCore.Web.WebPages.Razor</PackageId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Microsoft's builds use C# 9 (Web Stack, tools/WebStack.settings.targets) and Latest (Katana). -->
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0612;SYSLIB0003;SYSLIB0011;SYSLIB0051</NoWarn>
    <DefineConstants>$(DefineConstants);ASPNETWEBPAGES</DefineConstants>
    <!-- Delay signed with Microsoft's public key, as Microsoft's build does: PublicKeyToken=31bf3856ad364e35. -->
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../SigningKey/35MSSharedLib1024.snk</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="../webForCore.WebStack.targets" />

  <ItemGroup>
    <Compile Include="../../external/AspNetWebStack/src/System.Web.WebPages.Razor/AssemblyBuilderWrapper.cs" Link="AssemblyBuilderWrapper.cs" />
