<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<DefineConstants>$(DefineConstants);FEATURE_LEGACYSURFACEAREA;FEATURE_UTF32;FEATURE_UTF7;TRACE;RETAIL;WIN32</DefineConstants>
		<DefineConstants>$(DefineConstants);WebFormsForCore</DefineConstants>
		<SignAssembly>True</SignAssembly>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>System.Web.ApplicationServices</AssemblyName>

        <PackageId>webForCore.Web.ApplicationServices</PackageId>
        <Title>WebFormsForCore.Web.ApplicationServices</Title>
        <Product>WebFormsForCore.Web.ApplicationServices</Product>
        <Description>System.Web.ApplicationServices for webForCore: ASP.NET 4.x applications (Web Forms, MVC 5, Web API 2) on .NET 10 and Kestrel.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net10</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
		<Reference Include="System.Configuration" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' !='net48'">
	  <ProjectReference Include="..\WebFormsForCore.Configuration\WebFormsForCore.Configuration.csproj" />
	</ItemGroup>

    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />

    <PropertyGroup>
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>b03f5f7f11d50a3a</StrongNamePublicKeyToken>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <Compile Include="..\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
    </ItemGroup>
    <ItemGroup>
        <!-- The Reference Source's ApplicationServicesStrings.Designer.cs looks its strings up by this name. -->
        <EmbeddedResource Include="../../external/referencesource/System.Web.ApplicationServices/ApplicationServicesStrings.resx" Link="ApplicationServicesStrings.resx" LogicalName="System.Web.ApplicationServicesStrings.resources" />
    </ItemGroup>

  <!-- From the external/referencesource submodule (#61): the files that were lifted into this project, at their old paths. -->
  <ItemGroup>
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/ApplicationServicesStrings.Designer.cs" Link="ApplicationServicesStrings.Designer.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Configuration/MembershipPasswordCompatibilityMode.cs" Link="Configuration/MembershipPasswordCompatibilityMode.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Hosting/CustomLoaderAttribute.cs" Link="Hosting/CustomLoaderAttribute.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Hosting/CustomLoaderHelper.cs" Link="Hosting/CustomLoaderHelper.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Hosting/ICustomLoaderHelperFunctions.cs" Link="Hosting/ICustomLoaderHelperFunctions.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/DefaultMembershipAdapter.cs" Link="Security/DefaultMembershipAdapter.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/IMembershipAdapter.cs" Link="Security/IMembershipAdapter.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipCreateStatus.cs" Link="Security/MembershipCreateStatus.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipCreateUserException.cs" Link="Security/MembershipCreateUserException.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipPasswordException.cs" Link="Security/MembershipPasswordException.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipPasswordFormat.cs" Link="Security/MembershipPasswordFormat.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipProvider.cs" Link="Security/MembershipProvider.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipProviderCollection.cs" Link="Security/MembershipProviderCollection.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipUser.cs" Link="Security/MembershipUser.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipUserCollection.cs" Link="Security/MembershipUserCollection.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/MembershipValidatePasswordEventHandler.cs" Link="Security/MembershipValidatePasswordEventHandler.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/RoleProvider.cs" Link="Security/RoleProvider.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Security/ValidatePasswordEventArgs.cs" Link="Security/ValidatePasswordEventArgs.cs" />
    <Compile Include="../../external/referencesource/System.Web.ApplicationServices/Util/SecurityServices.cs" Link="Util/SecurityServices.cs" />
