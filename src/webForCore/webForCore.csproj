<Project Sdk="Microsoft.NET.Sdk">

  <!-- The webForCore package: no code of its own, it brings what every application needs (docs/MIGRATING.md section 3,
       "Always") and, through webForCore.Web, the build targets (buildTransitive/webForCore.Web.targets). -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PackageId>webForCore</PackageId>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>false</SuppressDependenciesWhenPacking>
    <!-- No lib folder: a package of dependencies only. -->
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <Description>webForCore: ASP.NET 4.x applications (Web Forms, MVC 5, Web API 2) on .NET 11 and Kestrel. This package brings System.Web and the assemblies every application needs; add webForCore.Web.Mvc, webForCore.Web.Http.WebHost and the others an application uses.</Description>
    <PackageTags>webforms;aspnet;system.web;porting;net11</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="True" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Configuration\WebFormsForCore.Configuration.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Web.ApplicationServices\WebFormsForCore.Web.ApplicationServices.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Web.Services\WebFormsForCore.Web.Services.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Web.Extensions\WebFormsForCore.Web.Extensions.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Web.Infrastructure\WebFormsForCore.Web.Infrastructure.csproj" />
    <!-- .NET Framework 4's System.Web.Abstractions and System.Web.Routing facades (in the GAC), which web.configs and
         .NET 3.5 libraries reference (#20). -->
    <ProjectReference Include="..\WebFormsForCore.Web.Abstractions\WebFormsForCore.Web.Abstractions.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Web.Routing\WebFormsForCore.Web.Routing.csproj" />
    <!-- WebActivatorEx, which finds its attributes in the application's load context (#21); packages that bring the
         original (Unity.Mvc, Ninject.MVC, ...) get this one. -->
    <ProjectReference Include="..\WebFormsForCore.WebActivatorEx\WebFormsForCore.WebActivatorEx.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Web.RegularExpressions\WebFormsForCore.Web.RegularExpressions.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Serialization.Formatters\WebFormsForCore.Serialization.Formatters.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Drawing\WebFormsForCore.Drawing.csproj" />
    <ProjectReference Include="..\WebFormsForCore.Compilers\WebFormsForCore.Compilers.csproj" />
    <!-- System.Web loads System.Web.DynamicData for every data control with ItemType (EnableDynamicData), as on .NET
         Framework, where it is in the GAC (#8). -->
    <ProjectReference Include="..\WebFormsForCore.Web.DynamicData\WebFormsForCore.Web.DynamicData.csproj" />
  </ItemGroup>
</Project>
