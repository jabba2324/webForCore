<Project Sdk="Microsoft.NET.Sdk">

    <!-- webForCore: WebActivatorEx 2.x, written from its documented API, which finds the activation attributes in the
         application's load context (#21). Part of the "Always" set; the original package, which packages such as
         Unity.Mvc bring, loses its conflicts to this one (webForCore.WebStack.targets). -->
    <PropertyGroup>
        <TargetFrameworks>net11.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>WebActivatorEx</AssemblyName>
        <RootNamespace>WebActivatorEx</RootNamespace>
        <SignAssembly>True</SignAssembly>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>

        <PackageId>webForCore.WebActivatorEx</PackageId>
        <Title>WebFormsForCore.WebActivatorEx</Title>
        <Product>WebFormsForCore.WebActivatorEx</Product>
        <Description>WebActivatorEx for webForCore: pre-start, post-start and shutdown methods for ASP.NET applications, written from the documented API, finding them in the application's load context</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net11</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />
    <PropertyGroup>
        <!-- WebActivatorEx's public key. -->
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>7b26dc2a43f6a0d4</StrongNamePublicKeyToken>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WebFormsForCore.Configuration\WebFormsForCore.Configuration.csproj" />
        <ProjectReference Include="..\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <Target Name="DropFrameworkSystemWeb" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
        <ItemGroup>
            <!-- Do not import System.Web from dotnet -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Web' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'[\\/]\.?dotnet[\\/]'))" />
        </ItemGroup>
    </Target>

</Project>
