<Project Sdk="Microsoft.NET.Sdk">

    <!-- webForCore: System.Web.Routing 4.0.0.0, the facade .NET Framework 4 has in the GAC: type forwarders to routing
         in System.Web, where it moved in 4.0. web.configs from MVC 2-4 projects list it in
         <compilation><assemblies>, and libraries built for .NET 3.5 reference it (#20). -->
    <PropertyGroup>
        <TargetFrameworks>net11.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>System.Web.Routing</AssemblyName>
        <SignAssembly>True</SignAssembly>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>

        <PackageId>webForCore.Web.Routing</PackageId>
        <Title>WebFormsForCore.Web.Routing</Title>
        <Product>WebFormsForCore.Web.Routing</Product>
        <Description>System.Web.Routing 4.0.0.0 for webForCore: the .NET Framework 4 facade that forwards RouteTable and the rest of routing to System.Web</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net11</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />
    <PropertyGroup>
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>31bf3856ad364e35</StrongNamePublicKeyToken>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <Target Name="DropFrameworkSystemWeb" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
        <ItemGroup>
            <!-- Do not import System.Web from dotnet -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Web' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'[\\/]\.?dotnet[\\/]'))" />
        </ItemGroup>
    </Target>

</Project>
