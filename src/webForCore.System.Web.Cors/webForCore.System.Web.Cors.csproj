<Project Sdk="Microsoft.NET.Sdk">

  <!-- From aspnet/AspNetWebStack 2106565 (System.Web.Cors) by way of the external/AspNetWebStack submodule (xforcore/AspNetWebStack's webforcore branch, #61).
       Apache License 2.0; see LICENSE-APACHE-2.0.txt and NOTICE at the repo root. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Web.Cors</AssemblyName>
    <!-- webForCore: the released 5.3.0's version, which Microsoft's build stamped in place of the source's development version (5.3.1.0) (#141). -->
    <MicrosoftAssemblyVersion>5.3.0.0</MicrosoftAssemblyVersion>
    <RootNamespace>System.Web.Cors</RootNamespace>
    <PackageId>webForCore.Web.Cors</PackageId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Microsoft's build uses C# 9 (tools/WebStack.settings.targets). -->
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0612;SYSLIB0003;SYSLIB0011;SYSLIB0051</NoWarn>
    <DefineConstants>$(DefineConstants);ASPNETMVC</DefineConstants>
    <!-- Delay signed with Microsoft's public key, as Microsoft's build does: PublicKeyToken=31bf3856ad364e35. -->
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../SigningKey/35MSSharedLib1024.snk</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="../webForCore.WebStack.targets" />

  <ItemGroup>
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Cors/CorsConstants.cs" Link="CorsConstants.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Cors/CorsEngine.cs" Link="CorsEngine.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Cors/CorsPolicy.cs" Link="CorsPolicy.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Cors/CorsRequestContext.cs" Link="CorsRequestContext.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Cors/CorsResult.cs" Link="CorsResult.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Cors/ICorsEngine.cs" Link="ICorsEngine.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Cors/Properties/AssemblyInfo.cs" Link="Properties/AssemblyInfo.cs" />
    <Compile Include="../../external/AspNetWebStack/src/CommonAssemblyInfo.cs" Link="Properties/CommonAssemblyInfo.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Cors/Properties/SRResources.Designer.cs" Link="Properties/SRResources.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../external/AspNetWebStack/src/System.Web.Cors/Properties/SRResources.resx" Link="Properties/SRResources.resx" LogicalName="System.Web.Cors.Properties.SRResources.resources" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CodeDom" Version="10.0.14" />
  </ItemGroup>
</Project>
