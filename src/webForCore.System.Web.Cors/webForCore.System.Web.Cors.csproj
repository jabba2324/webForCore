    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../SigningKey/35MSSharedLib1024.snk</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="../webForCore.WebStack.targets" />

  <ItemGroup>
    <Compile Include="CorsConstants.cs" />
    <Compile Include="CorsEngine.cs" />
    <Compile Include="CorsPolicy.cs" />
    <Compile Include="CorsRequestContext.cs" />
    <Compile Include="CorsResult.cs" />
    <Compile Include="ICorsEngine.cs" />
    <Compile Include="Properties/AssemblyInfo.cs" />
    <Compile Include="Properties/CommonAssemblyInfo.cs" />
    <Compile Include="Properties/SRResources.Designer.cs" />
