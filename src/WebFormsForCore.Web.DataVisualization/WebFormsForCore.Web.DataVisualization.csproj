<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>

        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <DefineConstants>$(DefineConstants);WebFormsForCore</DefineConstants>
        <SignAssembly>True</SignAssembly>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>System.Web.DataVisualization</AssemblyName>

        <PackageId>webForCore.Web.DataVisualization</PackageId>
        <Title>WebFormsForCore.Web.DataVisualization</Title>
        <Product>WebFormsForCore.Web.DataVisualization</Product>
        <Description>System.Web.DataVisualization for webForCore: ASP.NET 4.x applications (Web Forms, MVC 5, Web API 2) on .NET 10 and Kestrel.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net10</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md" Pack="True" PackagePath="\" />
    </ItemGroup>

    <!-- webForCore: the chart's strings (Common/SR.cs reads System.Web.UI.DataVisualization.Charting.SR.resources). -->
    <ItemGroup>
        <EmbeddedResource Remove="Common\SR.resx" />
        <EmbeddedResource Include="Common\SR.resx" LogicalName="System.Web.UI.DataVisualization.Charting.SR.resources" />
    </ItemGroup>

    <!-- webForCore: the project had no System.Web/System.Drawing references, so WebForm\ could not compile. -->
    <ItemGroup>
        <ProjectReference Include="..\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
        <!-- The chart code needs System.Drawing.Common (Graphics, Bitmap), which drawingForCore's System.Drawing brings;
             System.Drawing itself (type forwards only) stays out of the global namespace. -->
        <PackageReference Include="drawingForCore" Version="$(DrawingForCoreVersion)" Aliases="WfcDrawing" />
        <Compile Include="..\WebFormsForCore.Web\WebFormsForCore\AssemblyRef.cs" Link="Properties\AssemblyRef.cs" />
        <!-- Chart.DataBindTable/DataSource support SqlCommand/SqlDataReader/SqlDataAdapter; a separate package on modern .NET -->
        <ProjectReference Include="..\webForCore.System.Data.SqlClient\webForCore.System.Data.SqlClient.csproj" />
    </ItemGroup>
    <!-- webForCore: .NET Framework's public key token, 31bf3856ad364e35, as the other assemblies with Microsoft's names have (#141).
         It was WebFormsForCore.snk's, 6b8e2037dda5564b, so libraries built against .NET Framework's didn't compile against it. -->
    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />
    <PropertyGroup>
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>31bf3856ad364e35</StrongNamePublicKeyToken>
    </PropertyGroup>


    <Target Name="ChangeAliasesOfNugetRefs" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
        <ItemGroup>
            <!-- Do not import the NuGet System.Configuration.ConfigurationManager (the fork provides its own) -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Configuration.ConfigurationManager' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)system\.configuration\.configurationmanager[\\/]'))" />
            <!-- Do not import System.Web from dotnet -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Web' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)[\\/]microsoft\.netcore\.app\.ref[\\/]'))" />
        </ItemGroup>
    </Target>
</Project>
