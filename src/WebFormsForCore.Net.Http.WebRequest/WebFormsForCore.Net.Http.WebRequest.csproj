<Project Sdk="Microsoft.NET.Sdk">

    <!-- webForCore: System.Net.Http.WebRequest 4.0.0.0, the .NET Framework assembly with WebRequestHandler, which .NET
         doesn't have. Katana's social providers (Google, Facebook, MicrosoftAccount, Twitter) and WS-Federation create
         one (#18). Part of the "Always" set. -->
    <PropertyGroup>
        <TargetFrameworks>net11.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>System.Net.Http.WebRequest</AssemblyName>
        <RootNamespace>System.Net.Http</RootNamespace>
        <SignAssembly>True</SignAssembly>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>

        <PackageId>webForCore.Net.Http.WebRequest</PackageId>
        <Title>WebFormsForCore.Net.Http.WebRequest</Title>
        <Product>WebFormsForCore.Net.Http.WebRequest</Product>
        <Description>System.Net.Http.WebRequest for webForCore: .NET Framework's WebRequestHandler as an HttpClientHandler, for libraries built against it (Katana's social login providers)</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net11</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />
    <PropertyGroup>
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>b03f5f7f11d50a3a</StrongNamePublicKeyToken>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

</Project>
