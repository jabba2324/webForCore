<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<DefineConstants>$(DefineConstants);WebFormsForCore</DefineConstants>
		<SignAssembly>True</SignAssembly>
        <AssemblyName>System.Web.RegularExpressions</AssemblyName>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>

        <PackageId>WebFormsForCore.Web.RegularExpressions</PackageId>
        <Title>WebFormsForCore.Web.RegularExpressions</Title>
        <Product>WebFormsForCore.Web.RegularExpressions</Product>
        <Description>A port of ASP.NET WebForms to .NET 10</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>WebForms;porting WebForms;NET Core;NET 10</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>
    
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />

    <PropertyGroup>
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>b03f5f7f11d50a3a</StrongNamePublicKeyToken>
    </PropertyGroup>


    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
        <Compile Include="..\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
    </ItemGroup>
        
  <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
    <!-- webForCore: the classic regex classes were decompiled from System.Web.RegularExpressions.dll (generated by
         Regex.CompileToAssembly; the Reference Source has no source for them), so they are .NET Framework only. On .NET,
         System.Web parses with the source-generated NetCoreRegexes. See docs/LICENSING.md. -->
    <Compile Remove="*Regex*.cs" />
    <Compile Include="NetCoreRegexes.cs" />
  </ItemGroup>
</Project>