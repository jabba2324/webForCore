<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <DefineConstants>$(DefineConstants);FEATURE_LEGACYSURFACEAREA;FEATURE_UTF32;FEATURE_UTF7;SYSTEM_CONFIGURATION;TRACE;RETAIL;WIN32</DefineConstants>
        <DefineConstants>$(DefineConstants);WebFormsForCore</DefineConstants>
        <SignAssembly>True</SignAssembly>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>System.Configuration.ConfigurationManager</AssemblyName>

        <PackageId>webForCore.Configuration</PackageId>
        <Title>WebFormsForCore.Configuration</Title>
        <Product>WebFormsForCore.Configuration</Product>
        <Description>System.Configuration.ConfigurationManager for webForCore: ASP.NET 4.x applications (Web Forms, MVC 5, Web API 2) on .NET 10 and Kestrel.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net10</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
        <RestoreSources>$(RestoreSources);../../nupkg;https://api.nuget.org/v3/index.json;https://xforcore.github.io/drawingForCore/index.json</RestoreSources>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <Reference Include="System.Xml" />
        <Reference Include="System.Security" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <!--<PackageReference Include="System.Security.Cryptography.Algorithms" Version="4.3.1" />-->
        <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" />
        <!-- DPAPI on Windows (WebFormsForCore/Security/LocalDataProtection.cs). -->
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
        <PackageReference Include="System.CodeDom" Version="10.0.14" />
        <PackageReference Include="System.IO.FileSystem.AccessControl" Version="5.0.0" />
        <PackageReference Include="System.Security.Permissions" Version="10.0.14" />
        <!-- EventLogTraceListener, which <system.diagnostics> may name (System.Diagnostics.TraceUtils, #213); .NET's
             System.Configuration.ConfigurationManager depends on it too. -->
        <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="System\System.Configuration\ConfigurationPermission.cs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Remove="System\Configuration.resx" />
        <None Remove="machine.config" />
        <EmbeddedResource Include="Config\machine.netfx.config" />
        <EmbeddedResource Include="Config\machine.config" />
        <EmbeddedResource Include="System\Configuration.resx">
            <LogicalName>System.Configuration.resources</LogicalName>
        </EmbeddedResource>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' != 'net48'">
        <ProjectReference Include="..\WebFormsForCore.Serialization.Formatters\WebFormsForCore.Serialization.Formatters.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="System\Net\Configuration\" />
    </ItemGroup>

    <ItemGroup>
        <None Include="System\Configuration.resx" />
        <None Include="System\System.Configuration\ConfigurationPermission.cs" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="drawingForCore" Version="$(DrawingForCoreVersion)" />
      <!--<PackageReference Include="WebFormsForCore.Drawing" Version="1.7.0" />-->
    </ItemGroup>

    <ItemGroup>
      <Compile Update="System\Configuration\CodeDom\CodeDomProvider.cs" />
    </ItemGroup>

