    <ProjectReference Include="../webForCore.Microsoft.Owin/webForCore.Microsoft.Owin.csproj" />
    <PackageReference Include="Owin" Version="1.0.0" />
    <PackageReference Include="System.CodeDom" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>
