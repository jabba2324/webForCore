<Project>
  <!-- Imported by every project lifted from the ASP.NET Web Stack (src/webForCore.*, test/webForCore.*) and by the
       lifted Mono tests. -->
  <Target Name="WebForCoreFixReferences" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <!-- The shared framework ships a System.Web.dll facade (HttpUtility forwards); next to the fork's System.Web
           the compiler would see two System.Web assemblies (CS7069). The fork's own projects drop it the same way. -->
      <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Web' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'[\\/]packs[\\/]Microsoft\.NETCore\.App\.Ref[\\/]'))" />
      <!-- The fork ships its own System.Configuration.ConfigurationManager; drop the NuGet one that arrives transitively. -->
      <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Configuration.ConfigurationManager' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)[\\/]system\.configuration\.configurationmanager[\\/]'))" />
    </ItemGroup>
  </Target>

  <!-- The fork's System.Web contains Microsoft's System.Web.HttpUtility and System.Web.IHtmlString, as on .NET Framework.
       The shared framework's System.Web.HttpUtility.dll defines the same types, so code compiled against both gets
       CS0433 ("The type 'HttpUtility' exists in both ..."). Drop the framework copy wherever the fork's System.Web is
       referenced: as a project reference or from the webForCore.Web package. Upstream's NuGet WebFormsForCore.Web
       forwards HttpUtility to .NET's, so projects on that package keep .NET's. The repository's Directory.Build.targets
       defines the same target for its projects that don't import this file (the later definition wins; they agree). -->
  <Target Name="WebForCoreDropFrameworkHttpUtility" AfterTargets="ResolveAssemblyReferences" BeforeTargets="FindReferenceAssembliesForReferences" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_WebForCoreSystemWeb Include="@(ReferencePath)" Condition="'%(FileName)' == 'System.Web' AND ('%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' OR '%(ReferencePath.NuGetPackageId)' == 'webForCore.Web')" />
    </ItemGroup>
    <PropertyGroup>
      <_WebForCoreHasSystemWeb Condition="'@(_WebForCoreSystemWeb)' != ''">true</_WebForCoreHasSystemWeb>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WebForCoreHasSystemWeb)' == 'true'">
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'System.Web.HttpUtility' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(FullPath),'[\\/]packs[\\/]Microsoft\.(NETCore|AspNetCore)\.App\.Ref[\\/]'))" />
    </ItemGroup>
  </Target>

  <!-- Packages built on MVC, Web API, Katana or WebActivatorEx (Unity.Mvc, Autofac.Mvc5, Swashbuckle, ...) bring
       Microsoft's packages back transitively, with assemblies of the same names as webForCore's. The SDK keeps one of
       each by assembly version, then file version, and Microsoft's win ties: System.Web.Razor and System.Web.WebPages are
       3.0.0.0 in both, but Microsoft.AspNet.Razor 3.2.7's file version is 3.0.61128, so it replaced webForCore's in the
       output with no build error, and every Razor view failed with a MissingMethodException (#23: Bonobo Git Server,
       ApplicantTracking, ReaLocate, Roadkill). The webForCore packages in the build are preferred in those conflicts,
       as the SDK's PackageConflictPreferredPackages provides for. -->
  <Target Name="WebForCorePreferItsPackages" BeforeTargets="_HandlePackageFileConflicts;_HandlePackageFileConflictsForPublish" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_WebForCorePackageItem Include="@(Reference)" Condition="'%(Reference.NuGetPackageId)' == 'webForCore' OR $([System.String]::Copy('%(Reference.NuGetPackageId)').StartsWith('webForCore.'))" />
      <_WebForCorePackageItem Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'webForCore' OR $([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').StartsWith('webForCore.'))" />
      <_WebForCorePackageId Include="@(_WebForCorePackageItem->'%(NuGetPackageId)'->Distinct())" />
    </ItemGroup>
    <PropertyGroup>
      <PackageConflictPreferredPackages>@(_WebForCorePackageId);$(PackageConflictPreferredPackages)</PackageConflictPreferredPackages>
    </PropertyGroup>
  </Target>

  <!-- The shared framework also has System.Web, System.Drawing and System.Configuration facades. At startup the host
       keeps whichever copy has the higher assemblyVersion in deps.json, but the SDK writes no assemblyVersion for
       project references, so the framework facade won and the fork's System.Web failed to load ("conflicts with what
       is already bound"). The TestApp works around it with a hand-maintained deps.json; this sets the real versions
       for every app-local assembly that the shared frameworks also contain. -->
  <UsingTask TaskName="WebForCoreSetDepsAssemblyVersions" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <DepsFile ParameterType="System.String" Required="true" />
      <AppDirectory ParameterType="System.String" Required="true" />
      <FrameworkDirectories ParameterType="System.String[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(DepsFile)) return true;
        string json = File.ReadAllText(DepsFile);
        string patched = Regex.Replace(json, "\"([^\"/]+\\.dll)\": \\{([^{}]*)\\}", m =>
        {
            string file = m.Groups[1].Value;
            bool inFramework = false;
            foreach (string dir in FrameworkDirectories)
                if (File.Exists(Path.Combine(dir, file))) { inFramework = true; break; }
            string local = Path.Combine(AppDirectory, file);
            if (!inFramework || !File.Exists(local)) return m.Value;
            string version = AssemblyName.GetAssemblyName(local).Version.ToString();
            string body = Regex.Replace(m.Groups[2].Value, "\\s*\"assemblyVersion\": \"[^\"]*\",?", "").Trim().TrimEnd(',');
            Log.LogMessage(MessageImportance.Low, "deps.json: " + file + " assemblyVersion " + version);
            return "\"" + file + "\": { \"assemblyVersion\": \"" + version + "\"" + (body.Length > 0 ? ", " + body : "") + " }";
        });
        if (patched != json) File.WriteAllText(DepsFile, patched);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WebForCoreFixDepsAssemblyVersions" AfterTargets="GenerateBuildDependencyFile" Condition="'$(GenerateDependencyFile)' == 'true' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_WebForCoreFrameworkRefDir Include="$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/$(BundledNETCoreAppPackageVersion)/ref/$(TargetFramework)" />
      <_WebForCoreFrameworkRefDir Include="$(NetCoreTargetingPackRoot)/Microsoft.AspNetCore.App.Ref/$(BundledNETCoreAppPackageVersion)/ref/$(TargetFramework)" />
    </ItemGroup>
    <WebForCoreSetDepsAssemblyVersions DepsFile="$(ProjectDepsFilePath)" AppDirectory="$(OutDir)" FrameworkDirectories="@(_WebForCoreFrameworkRefDir)" />
  </Target>
</Project>
