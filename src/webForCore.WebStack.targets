<Project>
  <!-- Imported by every project lifted from the ASP.NET Web Stack (src/webForCore.*, test/webForCore.*) and by the
       lifted Mono tests. -->
  <Target Name="WebForCoreFixReferences" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <!-- The shared framework ships a System.Web.dll facade (HttpUtility forwards); next to the fork's System.Web
           the compiler would see two System.Web assemblies (CS7069). The fork's own projects drop it the same way. -->
      <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Web' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'[\\/]packs[\\/]Microsoft\.NETCore\.App\.Ref[\\/]'))" />
      <!-- The fork ships its own System.Configuration.ConfigurationManager; drop the NuGet one that arrives transitively. -->
      <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Configuration.ConfigurationManager' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)[\\/]system\.configuration\.configurationmanager[\\/]'))" />
    </ItemGroup>
  </Target>

  <!-- The fork's System.Web contains Microsoft's System.Web.HttpUtility and System.Web.IHtmlString, as on .NET Framework.
       The shared framework's System.Web.HttpUtility.dll defines the same types, so code compiled against both gets
       CS0433 ("The type 'HttpUtility' exists in both ..."). Drop the framework copy wherever the fork's System.Web is
       referenced: as a project reference or from the webForCore.Web package. Upstream's NuGet WebFormsForCore.Web
       forwards HttpUtility to .NET's, so projects on that package keep .NET's. The repository's Directory.Build.targets
       defines the same target for its projects that don't import this file (the later definition wins; they agree). -->
  <Target Name="WebForCoreDropFrameworkHttpUtility" AfterTargets="ResolveAssemblyReferences" BeforeTargets="FindReferenceAssembliesForReferences" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_WebForCoreSystemWeb Include="@(ReferencePath)" Condition="'%(FileName)' == 'System.Web' AND ('%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' OR '%(ReferencePath.NuGetPackageId)' == 'webForCore.Web')" />
    </ItemGroup>
    <PropertyGroup>
      <_WebForCoreHasSystemWeb Condition="'@(_WebForCoreSystemWeb)' != ''">true</_WebForCoreHasSystemWeb>
    </PropertyGroup>
    <ItemGroup Condition="'$(_WebForCoreHasSystemWeb)' == 'true'">
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'System.Web.HttpUtility' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(FullPath),'(?i)[\\/]Microsoft\.(NETCore|AspNetCore)\.App\.Ref[\\/]'))" />
    </ItemGroup>
  </Target>

  <!-- The fork's System.Web.Services contains the System.Web.Services.Description namespace, as on .NET Framework
       (WsiProfiles, SoapBindingUse, ...). CoreWCF, which System.Web.Extensions' WCF client support uses, depends on the
       System.Web.Services.Description package, whose reference assembly defines the same types, so code that names them
       got CS0433: Visual Studio's generic handler template ([WebServiceBinding(ConformsTo = WsiProfiles.BasicProfile1_1)],
       mojoPortal's .ashx handlers) and SOAP client proxies (Subtext's Web References) (#34). Drop the package's compile
       reference wherever the fork's System.Web.Services is referenced; CoreWCF still gets it at run time. -->
  <Target Name="WebForCoreDropServicesDescriptionPackage" AfterTargets="ResolveAssemblyReferences" BeforeTargets="FindReferenceAssembliesForReferences" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_WebForCoreSystemWebServices Include="@(ReferencePath)" Condition="'%(FileName)' == 'System.Web.Services' AND ('%(ReferencePath.ReferenceSourceTarget)' == 'ProjectReference' OR '%(ReferencePath.NuGetPackageId)' == 'webForCore.Web.Services')" />
    </ItemGroup>
    <ItemGroup Condition="'@(_WebForCoreSystemWebServices)' != ''">
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(FileName)' == 'System.Web.Services.Description' AND '%(ReferencePath.NuGetPackageId)' == 'System.Web.Services.Description'" />
    </ItemGroup>
  </Target>

  <!-- Packages built on MVC, Web API or Katana (Unity.Mvc, Autofac.Mvc5, Swashbuckle, ...) bring
       Microsoft's packages back transitively, with assemblies of the same names as webForCore's. The SDK keeps one of
       each by assembly version, then file version, so Microsoft's won where the assembly versions tie:
       System.Web.Razor and System.Web.WebPages are 3.0.0.0 in both, and Microsoft.AspNet.WebPages 3.1.0's file version
       is 3.0.20110. They replaced webForCore's in the output with no build error, and MVC views failed with a
       MissingMethodException (#23: Bonobo Git Server, ApplicantTracking, ReaLocate, Roadkill, eShopLegacyMVC). Package
       overrides come before versions in the SDK's conflict resolution (they are how the shared framework wins over the
       System.* packages): each webForCore package in the build overrides the Microsoft packages webForCore replaces,
       at any version. The packages of webForCore-thirdparty (WebActivatorEx, AjaxControlToolkit) declare their own. -->
  <PropertyGroup>
    <_WebForCoreReplacedPackages>
      Microsoft.AspNet.Mvc|99.0.0;Microsoft.AspNet.Mvc.Futures|99.0.0;Microsoft.AspNet.Razor|99.0.0;
      Microsoft.AspNet.WebPages|99.0.0;Microsoft.AspNet.WebApi.Core|99.0.0;Microsoft.AspNet.WebApi.WebHost|99.0.0;
      Microsoft.AspNet.WebApi.Owin|99.0.0;Microsoft.AspNet.WebApi.Cors|99.0.0;Microsoft.AspNet.WebApi.Tracing|99.0.0;Microsoft.AspNet.WebApi.Client|99.0.0;
      Microsoft.AspNet.Cors|99.0.0;Microsoft.AspNet.Web.Optimization|99.0.0;Microsoft.AspNet.Web.Optimization.WebForms|99.0.0;
      WebGrease|99.0.0;Microsoft.Web.Infrastructure|99.0.0;Microsoft.AspNet.Identity.Core|99.0.0;
      Microsoft.AspNet.Identity.EntityFramework|99.0.0;Microsoft.AspNet.Identity.Owin|99.0.0;
      Microsoft.AspNet.SignalR.Core|99.0.0;Microsoft.AspNet.SignalR.SystemWeb|99.0.0;Microsoft.AspNet.SignalR.Client|99.0.0;
      Microsoft.Owin|99.0.0;Microsoft.Owin.Host.SystemWeb|99.0.0;Microsoft.Owin.Host.HttpListener|99.0.0;
      Microsoft.Owin.Hosting|99.0.0;Microsoft.Owin.Security|99.0.0;Microsoft.Owin.Security.Cookies|99.0.0;
      Microsoft.Owin.Security.OAuth|99.0.0;Microsoft.Owin.Cors|99.0.0;Microsoft.Owin.Testing|99.0.0;
      Microsoft.Owin.Security.OpenIdConnect|99.0.0;Microsoft.Owin.Security.Jwt|99.0.0;Microsoft.Owin.Security.WsFederation|99.0.0;
      Microsoft.Owin.Security.ActiveDirectory|99.0.0;Microsoft.Owin.Security.Google|99.0.0;Microsoft.Owin.Security.Facebook|99.0.0;
      Microsoft.Owin.Security.MicrosoftAccount|99.0.0;Microsoft.Owin.Security.Twitter|99.0.0
    </_WebForCoreReplacedPackages>
  </PropertyGroup>
  <Target Name="WebForCoreOverrideReplacedPackages" BeforeTargets="_HandlePackageFileConflicts;_HandlePackageFileConflictsForPublish" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_WebForCorePackageItem Include="@(Reference)" Condition="'%(Reference.NuGetPackageId)' == 'webForCore' OR $([System.String]::Copy('%(Reference.NuGetPackageId)').StartsWith('webForCore.'))" />
      <_WebForCorePackageItem Include="@(RuntimeCopyLocalItems)" Condition="'%(RuntimeCopyLocalItems.NuGetPackageId)' == 'webForCore' OR $([System.String]::Copy('%(RuntimeCopyLocalItems.NuGetPackageId)').StartsWith('webForCore.'))" />
      <_WebForCorePackageId Include="@(_WebForCorePackageItem->'%(NuGetPackageId)'->Distinct())" />
      <PackageConflictOverrides Include="@(_WebForCorePackageId)" OverriddenPackages="$(_WebForCoreReplacedPackages)" />
    </ItemGroup>
  </Target>

  <!-- webForCore builds System.Data.SqlClient from Microsoft's source, fixed (#41): Microsoft's packages, 4.4.3 to 4.9.1,
       contain a type .NET 8 and later can't load, so Assembly.GetTypes() on the assembly threw a
       ReflectionTypeLoadException, and an application that scans every loaded assembly failed (webForCore's own
       scanners, MVC's, Web API's and SignalR's, already skip what doesn't load, as on .NET Framework). Both packages
       have an assembly of the same identity, System.Data.SqlClient 4.6.1.6, with windows and unix builds as runtime
       targets (runtimes/win/lib/..., runtimes/unix/lib/...) at other paths in each, so the SDK's conflict resolution
       doesn't see them as conflicts and package overrides can't remove them: deps.json would list both packages'
       builds, and the host would load whichever came first. So exactly one of them stays, decided as soon as NuGet's
       assets are resolved, the same way in every build, and nothing of the other reaches the compiler, the output,
       deps.json or a publish (#195):
       - Microsoft's, when the build has its System.Data.SqlClient package at 4.9.0 or later (referenced by the
         application or by any project or package it references): an application chooses Microsoft's supported package
         by referencing it.
       - Otherwise webForCore's (the webForCore.Data.SqlClient package, which webForCore.Web depends on, or this
         repository's project): Entity Framework 6.5.1 brings Microsoft's 4.8.6, ServiceStack's OrmLite 4.8.1, and
         those are replaced.
       WebForCoreSystemDataSqlClient=Microsoft or webForCore decides it whatever the versions. The build says which one
       it kept when both were there. -->
  <Target Name="WebForCoreDropSystemDataSqlClientPackage" AfterTargets="ResolvePackageAssets" DependsOnTargets="IncludeTransitiveProjectReferences" Condition="'$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_WebForCoreSqlClient Include="@(ResolvedCompileFileDefinitions);@(RuntimeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'webForCore.Data.SqlClient'" />
      <_WebForCoreSqlClientProject Include="@(ProjectReference)" Condition="'%(Filename)' == 'webForCore.System.Data.SqlClient'" />
      <_MicrosoftSqlClient Include="@(ResolvedCompileFileDefinitions);@(RuntimeCopyLocalItems);@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'System.Data.SqlClient'" />
    </ItemGroup>
    <PropertyGroup>
      <_MicrosoftSqlClientVersion>@(_MicrosoftSqlClient->'%(NuGetPackageVersion)'->Distinct())</_MicrosoftSqlClientVersion>
      <_WebForCoreSqlClientChoice>$(WebForCoreSystemDataSqlClient)</_WebForCoreSqlClientChoice>
      <!-- This repository's own projects build against the project, which can't be left out. -->
      <_WebForCoreSqlClientChoice Condition="'$(_WebForCoreSqlClientChoice)' == '' AND '@(_WebForCoreSqlClientProject)' != ''">webForCore</_WebForCoreSqlClientChoice>
      <_WebForCoreSqlClientChoice Condition="'$(_WebForCoreSqlClientChoice)' == '' AND '$(_MicrosoftSqlClientVersion)' != '' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_MicrosoftSqlClientVersion)', '4.9.0'))">Microsoft</_WebForCoreSqlClientChoice>
      <_WebForCoreSqlClientChoice Condition="'$(_WebForCoreSqlClientChoice)' == ''">webForCore</_WebForCoreSqlClientChoice>
    </PropertyGroup>
    <Error Condition="'$(_WebForCoreSqlClientChoice)' == 'Microsoft' AND '$(_MicrosoftSqlClientVersion)' == ''" Code="WFC0195"
           Text="WebForCoreSystemDataSqlClient is Microsoft, but the build has no System.Data.SqlClient package: reference Microsoft's System.Data.SqlClient package (4.9.0 or later), or remove the property (#195)." />
    <Message Importance="high" Condition="'@(_WebForCoreSqlClient)' != '' AND '$(_MicrosoftSqlClientVersion)' != '' AND '$(_WebForCoreSqlClientChoice)' == 'Microsoft'"
             Text="webForCore: System.Data.SqlClient is Microsoft's, from its System.Data.SqlClient $(_MicrosoftSqlClientVersion) package; webForCore.Data.SqlClient is left out (#195)." />
    <Message Importance="high" Condition="'@(_WebForCoreSqlClient)' != '' AND '$(_MicrosoftSqlClientVersion)' != '' AND '$(_WebForCoreSqlClientChoice)' != 'Microsoft'"
             Text="webForCore: System.Data.SqlClient is webForCore.Data.SqlClient's; Microsoft's System.Data.SqlClient $(_MicrosoftSqlClientVersion) package is left out. Reference Microsoft's 4.9.0 or later to use it instead (#41, #195)." />
    <ItemGroup Condition="'$(_WebForCoreSqlClientChoice)' == 'Microsoft'">
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(NuGetPackageId)' == 'webForCore.Data.SqlClient'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'webForCore.Data.SqlClient'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'webForCore.Data.SqlClient'" />
    </ItemGroup>
    <ItemGroup Condition="'$(_WebForCoreSqlClientChoice)' != 'Microsoft' AND ('@(_WebForCoreSqlClient)' != '' OR '@(_WebForCoreSqlClientProject)' != '')">
      <ResolvedCompileFileDefinitions Remove="@(ResolvedCompileFileDefinitions)" Condition="'%(NuGetPackageId)' == 'System.Data.SqlClient'" />
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'System.Data.SqlClient'" />
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'System.Data.SqlClient'" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'System.Data.SqlClient'" />
      <ResourceCopyLocalItems Remove="@(ResourceCopyLocalItems)" Condition="'%(NuGetPackageId)' == 'System.Data.SqlClient'" />
    </ItemGroup>
  </Target>

  <!-- The shared framework also has System.Web, System.Drawing and System.Configuration facades. At startup the host
       keeps whichever copy has the higher assemblyVersion in deps.json, but the SDK writes no assemblyVersion for
       project references, so the framework facade won and the fork's System.Web failed to load ("conflicts with what
       is already bound"). The TestApp works around it with a hand-maintained deps.json; this sets the real versions
       for every app-local assembly that the shared frameworks also contain. -->
  <UsingTask TaskName="WebForCoreSetDepsAssemblyVersions" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <DepsFile ParameterType="System.String" Required="true" />
      <AppDirectory ParameterType="System.String" Required="true" />
      <FrameworkDirectories ParameterType="System.String[]" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Reflection" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!File.Exists(DepsFile)) return true;
        string json = File.ReadAllText(DepsFile);
        string patched = Regex.Replace(json, "\"([^\"/]+\\.dll)\": \\{([^{}]*)\\}", m =>
        {
            string file = m.Groups[1].Value;
            bool inFramework = false;
            foreach (string dir in FrameworkDirectories)
                if (File.Exists(Path.Combine(dir, file))) { inFramework = true; break; }
            string local = Path.Combine(AppDirectory, file);
            if (!inFramework || !File.Exists(local)) return m.Value;
            string version = AssemblyName.GetAssemblyName(local).Version.ToString();
            string body = Regex.Replace(m.Groups[2].Value, "\\s*\"assemblyVersion\": \"[^\"]*\",?", "").Trim().TrimEnd(',');
            Log.LogMessage(MessageImportance.Low, "deps.json: " + file + " assemblyVersion " + version);
            return "\"" + file + "\": { \"assemblyVersion\": \"" + version + "\"" + (body.Length > 0 ? ", " + body : "") + " }";
        });
        if (patched != json) File.WriteAllText(DepsFile, patched);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WebForCoreFixDepsAssemblyVersions" AfterTargets="GenerateBuildDependencyFile" Condition="'$(GenerateDependencyFile)' == 'true' AND '$(TargetFrameworkIdentifier)' == '.NETCoreApp'">
    <ItemGroup>
      <_WebForCoreFrameworkRefDir Include="$(NetCoreTargetingPackRoot)/Microsoft.NETCore.App.Ref/$(BundledNETCoreAppPackageVersion)/ref/$(TargetFramework)" />
      <_WebForCoreFrameworkRefDir Include="$(NetCoreTargetingPackRoot)/Microsoft.AspNetCore.App.Ref/$(BundledNETCoreAppPackageVersion)/ref/$(TargetFramework)" />
    </ItemGroup>
    <WebForCoreSetDepsAssemblyVersions DepsFile="$(ProjectDepsFilePath)" AppDirectory="$(OutDir)" FrameworkDirectories="@(_WebForCoreFrameworkRefDir)" />
  </Target>
</Project>
