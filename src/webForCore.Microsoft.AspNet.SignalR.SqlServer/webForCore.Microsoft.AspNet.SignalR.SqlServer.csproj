<Project Sdk="Microsoft.NET.Sdk">

  <!-- From SignalR/SignalR 7f53f26 (src/Microsoft.AspNet.SignalR.SqlServer) by way of the external/SignalR submodule (xforcore/SignalR's webforcore branch, #61).
       Apache License 2.0; see LICENSE-APACHE-2.0.txt and NOTICE at the repo root. A scale-out backplane: SignalR's message
       bus across several instances of an application. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Microsoft.AspNet.SignalR.SqlServer</AssemblyName>
    <RootNamespace>Microsoft.AspNet.SignalR.SqlServer</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyVersion>2.4.3.0</AssemblyVersion>
    <FileVersion>2.4.3.0</FileVersion>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <GenerateAssemblyTitleAttribute>false</GenerateAssemblyTitleAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- The C# version of Microsoft's build, as in Microsoft.AspNet.SignalR.Core. -->
    <LangVersion>7.3</LangVersion>
    <DefineConstants>$(DefineConstants);SERVER;NET45;SIGNED</DefineConstants>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0612;CA1416;SYSLIB0011;SYSLIB0051;SYSLIB0014;SYSLIB0057</NoWarn>
    <!-- Delay signed with Microsoft's public key, as Microsoft's build does: PublicKeyToken=31bf3856ad364e35. -->
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../SigningKey/35MSSharedLib1024.snk</AssemblyOriginatorKeyFile>
    <PackageId>webForCore.Microsoft.AspNet.SignalR.SqlServer</PackageId>
    <Description>SQL Server messaging backplane for scaling out of ASP.NET SignalR applications in a web-farm.</Description>
    <IsTestProject>false</IsTestProject>
  </PropertyGroup>

