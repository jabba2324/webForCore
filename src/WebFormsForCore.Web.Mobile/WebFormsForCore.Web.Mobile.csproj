<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <DefineConstants>$(DefineConstants);FEATURE_LEGACYSURFACEAREA;FEATURE_UTF32;FEATURE_UTF7;SYSTEM_WEB;OBJECTSTATEFORMATTER;CONFIGPATHUTILITY_SYSTEMWEB;SAFESERIALIZATIONMANAGER;TRACE;RETAIL;WIN32</DefineConstants>
        <DefineConstants>$(DefineConstants);WebFormsForCore</DefineConstants>
        <SignAssembly>True</SignAssembly>
        <AssemblyOriginatorKeyFile>..\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>System.Web.Mobile</AssemblyName>
        <!-- webForCore: .NET Framework 4's identity (#141). -->
        <MicrosoftAssemblyVersion>4.0.0.0</MicrosoftAssemblyVersion>

        <PackageId>webForCore.Web.Mobile</PackageId>
        <Title>WebFormsForCore.Web.Mobile</Title>
        <Product>WebFormsForCore.Web.Mobile</Product>
        <Description>System.Web.Mobile for webForCore: ASP.NET 4.x applications (Web Forms, MVC 5, Web API 2) on .NET 10 and Kestrel.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>webforms;aspnet;system.web;porting;net10</PackageTags>
        <IncludeSymbols>true</IncludeSymbols>
        <EmbedUntrackedSources>false</EmbedUntrackedSources>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup Condition="$(TargetFramework) == 'net10.0'">
        <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" Alias="NET" />
    </ItemGroup>

    <Import Project="..\..\lib\WebFormsForCore.Build\netstandard2.0\FakeStrongName.targets" />

    <PropertyGroup>
        <StrongNamePublicKey></StrongNamePublicKey>
        <StrongNamePublicKeyToken>b03f5f7f11d50a3a</StrongNamePublicKeyToken>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Include="..\VersionInfo.cs" Link="Properties\VersionInfo.cs" />
        <!-- webForCore (#212): .NET Framework's StringComparer.InvariantCultureIgnoreCase hash for MobilePage's view state
             MAC key, as System.Web has it (System.Web's internals aren't visible here). -->
        <Compile Include="..\WebFormsForCore.Web\WebFormsForCore\InvariantIgnoreCaseHash.cs" Link="WebFormsForCore\InvariantIgnoreCaseHash.cs" />
        <EmbeddedResource Include="..\WebFormsForCore.Web\FrameworkData\InvariantIgnoreCaseWeights.txt" Link="FrameworkData\InvariantIgnoreCaseWeights.txt">
            <LogicalName>System.Web.Util.InvariantIgnoreCaseWeights.txt</LogicalName>
        </EmbeddedResource>
        <Compile Remove="UI\MobileControls\Design\Adapters\**\*.cs" />
        <Compile Remove="UI\MobileControls\Design\Util\**\*.cs" />
        <Compile Remove="UI\MobileControls\Design\*.cs" />
        <None Include="UI\MobileControls\Design\**\*.cs" Exclude="UI\MobileControls\Design\Converters\**\*.cs" />
        <EmbeddedResource Remove="**\*.resx" />
        <EmbeddedResource Include="System.Web.Mobile.resx">
            <LogicalName>System.Web.Mobile.resources</LogicalName>
        </EmbeddedResource>
        <EmbeddedResource Include="UI\MobileControls\Adapters.resx">
            <LogicalName>System.Web.UI.MobileControls.Adapters.resources</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <None Remove="**\*.bmp" />
        <EmbeddedResource Include="**\*.bmp" />
        <None Remove="UI\MobileControls\Design\Util\DesignerUtility.cs" />
        <None Remove="UI\MobileControls\Design\Util\UrlBuilder.cs" />
        <Compile Include="UI\MobileControls\Design\Util\DesignerUtility.cs" />
        <Compile Include="UI\MobileControls\Design\Util\UrlBuilder.cs" />
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <Target Name="ChangeAliasesOfNugetRefs" BeforeTargets="FindReferenceAssembliesForReferences;ResolveReferences">
        <ItemGroup>
            <!-- Do not import System.Configuration.ConfigurationManager version 8 -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Configuration.ConfigurationManager' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)system\.configuration\.configurationmanager[\\/]'))" />
            <!-- Do not import System.Web from dotnet -->
            <ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Web' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)[\\/]microsoft\.netcore\.app\.ref[\\/]'))" />
            <!-- Do not import System.Drawing from dotnet -->
            <!--<ReferencePath Remove="%(Identity)" Condition="'%(FileName)' == 'System.Drawing' AND $([System.Text.RegularExpressions.Regex]::IsMatch(%(Identity),'(?i)[\\/]microsoft\.netcore\.app\.ref[\\/]'))" />-->
        </ItemGroup>
    </Target>

</Project>
