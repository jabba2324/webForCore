<Project Sdk="Microsoft.NET.Sdk">

  <!-- From aspnet/AspNetWebStack 2106565 (System.Web.Http.Tracing) by way of the external/AspNetWebStack submodule (xforcore/AspNetWebStack's webforcore branch, #61).
       Apache License 2.0; see LICENSE-APACHE-2.0.txt and NOTICE at the repo root. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Web.Http.Tracing</AssemblyName>
    <!-- webForCore: the released 5.3.0's version, which Microsoft's build stamped in place of the source's development version (5.3.1.0) (#141). -->
    <MicrosoftAssemblyVersion>5.3.0.0</MicrosoftAssemblyVersion>
    <RootNamespace>System.Web.Http.Tracing</RootNamespace>
    <PackageId>webForCore.Web.Http.Tracing</PackageId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Microsoft's build uses C# 9 (tools/WebStack.settings.targets). -->
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0612;SYSLIB0003;SYSLIB0011;SYSLIB0051</NoWarn>
    <DefineConstants>$(DefineConstants);ASPNETMVC</DefineConstants>
    <!-- Delay signed with Microsoft's public key, as Microsoft's build does: PublicKeyToken=31bf3856ad364e35. -->
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../SigningKey/35MSSharedLib1024.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <Import Project="../webForCore.WebStack.targets" />

  <ItemGroup>
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Http.Tracing/HttpConfigurationExtensions.cs" Link="HttpConfigurationExtensions.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Http.Tracing/SystemDiagnosticsTraceWriter.cs" Link="SystemDiagnosticsTraceWriter.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Http.Tracing/Properties/AssemblyInfo.cs" Link="Properties/AssemblyInfo.cs" />
    <Compile Include="../../external/AspNetWebStack/src/CommonAssemblyInfo.cs" Link="Properties/CommonAssemblyInfo.cs" />
    <Compile Include="../../external/AspNetWebStack/src/System.Web.Http.Tracing/Properties/SRResources.Designer.cs" Link="Properties/SRResources.Designer.cs" />
    <Compile Include="../../external/AspNetWebStack/src/Common/Error.cs" Link="Common/Error.cs" />
    <Compile Include="../../external/AspNetWebStack/src/Common/TraceWriterExceptionMapper.cs" Link="Common/TraceWriterExceptionMapper.cs" />
    <Compile Include="../../external/AspNetWebStack/src/Common/CommonWebApiResources.Designer.cs" Link="Properties/CommonWebApiResources.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../external/AspNetWebStack/src/System.Web.Http.Tracing/Properties/SRResources.resx" Link="Properties/SRResources.resx" LogicalName="System.Web.Http.Tracing.Properties.SRResources.resources" />
    <EmbeddedResource Include="../../external/AspNetWebStack/src/Common/CommonWebApiResources.resx" Link="Properties/CommonWebApiResources.resx" LogicalName="System.Web.Http.Properties.CommonWebApiResources.resources" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../webForCore.System.Net.Http.Formatting/webForCore.System.Net.Http.Formatting.csproj" />
    <ProjectReference Include="../webForCore.System.Web.Http/webForCore.System.Web.Http.csproj" />
  </ItemGroup>
</Project>
