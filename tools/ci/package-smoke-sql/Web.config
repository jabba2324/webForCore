<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- The SQL providers' database, as docs/MIGRATING.md says to point machine.config's at a SQL Server. -->
    <remove name="LocalSqlServer" />
    <add name="LocalSqlServer" providerName="System.Data.SqlClient"
         connectionString="Data Source=127.0.0.1,14333;User ID=sa;Password=webForCore-Test1!;TrustServerCertificate=True;Initial Catalog=webforcore_smoke_sql" />
  </connectionStrings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <roleManager enabled="true" />
    <profile>
      <properties>
        <add name="Color" />
      </properties>
    </profile>
    <sessionState mode="SQLServer" allowCustomSqlDatabase="true"
                  sqlConnectionString="Data Source=127.0.0.1,14333;User ID=sa;Password=webForCore-Test1!;TrustServerCertificate=True;Initial Catalog=webforcore_smoke_sql" />
    <caching>
      <sqlCacheDependency enabled="true" pollTime="500">
        <databases>
          <add name="smoke" connectionStringName="LocalSqlServer" />
        </databases>
      </sqlCacheDependency>
    </caching>
  </system.web>
</configuration>
