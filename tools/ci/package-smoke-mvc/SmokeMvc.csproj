<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- An MVC 5 and OWIN application that uses webForCore through its packages only (tools/ci/package-smoke.sh), with
       the third-party packages real applications have: Unity.Mvc and WebActivatorEx (which bring Microsoft.AspNet.Mvc,
       Razor and Web Pages back transitively, #23) and Katana's Google provider (#18). WebActivatorEx's start methods don't
       run on webForCore (#21), so Unity is started from Application_Start, as docs/MIGRATING.md says. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <OutputPath>bin_dotnet</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <PredefinedCulturesOnly>true</PredefinedCulturesOnly>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="bin_dotnet\**;obj\**" />
    <Content Remove="bin_dotnet\**" />
    <None Remove="bin_dotnet\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="webForCore" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Web.Mvc" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Microsoft.Owin.Host.SystemWeb" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Microsoft.Owin.Security.Cookies" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Microsoft.Owin.Security.OpenIdConnect" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Microsoft.Owin.Security.Jwt" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Microsoft.AspNet.SignalR.SystemWeb" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Web.DataVisualization" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Web.Http.WebHost" Version="$(WebForCoreVersion)" />
    <PackageReference Include="webForCore.Web.Optimization" Version="$(WebForCoreVersion)" />
  </ItemGroup>

  <ItemGroup>
    <!-- As the applications have them, with no ExcludeAssets. -->
    <PackageReference Include="Unity.Mvc" Version="5.11.1" />
    <PackageReference Include="WebActivatorEx" Version="2.2.0" />
    <PackageReference Include="Microsoft.Owin.Security.Google" Version="3.0.1" />
    <!-- Third-party, net45: depends on Microsoft.Owin.Security.Jwt 4.0.1 and IdentityModel 5.6, which webForCore's Katana
         packages and the IdentityModel 8 that CoreWCF brings replace (no NU1605, one IdentityModel version). -->
    <PackageReference Include="IdentityServer3.Contrib.AccessTokenValidation" Version="4.1.16" />
    <!-- Microsoft's, which webForCore doesn't lift: built against Microsoft's SignalR 2.4.3 (#40, JabbR). -->
    <PackageReference Include="Microsoft.AspNet.SignalR.SqlServer" Version="2.4.3" />
    <!-- Brings Microsoft's System.Data.SqlClient 4.8.6, which webForCore's replaces (#41). -->
    <PackageReference Include="EntityFramework" Version="6.5.1" />
    <!-- Built for .NET Framework; its model builder needs System.Data.Linq, which the webForCore package brings (#142). -->
    <PackageReference Include="Microsoft.AspNet.OData" Version="7.5.18" />
    <!-- Built against Microsoft's System.Web.Optimization 1.1.0.0, as SmartStoreNET has it (#141). -->
    <PackageReference Include="BundleTransformer.Core" Version="1.10.0" />
  </ItemGroup>

  <!-- -p:SmokeSqlClient=Microsoft: the application references Microsoft's supported System.Data.SqlClient package, at a
       later version than webForCore's, which then is the one in the build (#195). -->
  <ItemGroup Condition="'$(SmokeSqlClient)' == 'Microsoft'">
    <PackageReference Include="System.Data.SqlClient" Version="4.9.1" />
  </ItemGroup>
</Project>
