<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8">
      <assemblies>
        <!-- #142: as Visual Studio 2008's web.configs list it (mojoPortal, Subtext), which upgraded applications keep.
             Linq.aspx compiles against it. -->
        <add assembly="System.Data.Linq, Version=3.5.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
      </assemblies>
    </compilation>
    <!-- #27: as in MVCForum's web.config; MapPath.aspx checks that MapPath still maps. -->
    <httpRuntime targetFramework="4.8" relaxedUrlToFileSystemMapping="true" />
  </system.web>
</configuration>
