<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- As the "Work or School Accounts" template has them; the gate overrides the URLs (WFC_IDA_*), and the IIS build
         writes CI's. -->
    <add key="ida:ClientId" value="wfc-oidc-sample" />
    <add key="ida:ClientSecret" value="wfc-oidc-sample-secret" />
    <add key="ida:Authority" value="http://127.0.0.1:8101" />
    <add key="ida:RedirectUri" value="http://127.0.0.1:8100/signin-oidc" />
    <add key="ida:PostLogoutRedirectUri" value="http://127.0.0.1:8100/" />
    <add key="ida:ApiAudience" value="api://wfc-oidc-sample" />
  </appSettings>
  <system.web>
    <authentication mode="None" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- A fixed key, so that a cookie protected on one server reads on another. -->
    <machineKey validationKey="6B0B5E3D1A9C4F2E8D7C6B5A4F3E2D1C0B9A8F7E6D5C4B3A2F1E0D9C8B7A6F5E4D3C2B1A0F9E8D7C6B5A4F3E2D1C0B9A8F7E6D5C4B3A2F1E0D9C8B7A6F5E4D3C" decryptionKey="0F1E2D3C4B5A69788796A5B4C3D2E1F00F1E2D3C4B5A6978" validation="HMACSHA256" decryption="AES" />
  </system.web>
  <location path="Secure">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <modules>
      <remove name="FormsAuthentication" />
    </modules>
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
</configuration>
