<Project Sdk="Microsoft.NET.Sdk">

  <!-- test/webForCore.VirtualPath.Sample for IIS 10 and .NET Framework 4.8 (#190, #194): the same source files, pages,
       scripts, styles, Global.asax and Web.config, built against Microsoft's NuGet packages of MVC 5, Web API 2 and
       System.Web.Optimization instead of webForCore's. CI's iis-compare job serves it from IIS as the application /app of a
       site whose root is empty (integrated pipeline, as MVC and Web API's extensionless URLs need on IIS) and sends it the
       requests that VirtualPathTests recorded on Kestrel (vpath-responses.json); tools/ci/iis_compare.cs diffs the two.
       Not in WebFormsForCore.slnx: only that job builds it. It builds on Linux too (reference assemblies).

       The application is written to $(IisSiteDirectory) (obj/site by default): Global.asax, the pages, Scripts, Content,
       the sample's Web.config with the binding redirects the packages need (as NuGet writes them into a Visual Studio
       project's Web.config), and bin. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>webForCore.VirtualPath.Sample</AssemblyName>
    <RootNamespace>VirtualPathSample</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <IisSiteDirectory Condition="'$(IisSiteDirectory)' == ''">$(MSBuildProjectDirectory)\obj\site\</IisSiteDirectory>
    <Sample>$(MSBuildProjectDirectory)\..\webForCore.VirtualPath.Sample\</Sample>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.cs is the Kestrel entry point; IIS starts the application from Global.asax. -->
    <Compile Include="$(Sample)**\*.cs" Exclude="$(Sample)Program.cs;$(Sample)bin_dotnet\**;$(Sample)obj\**;$(Sample)bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <PackageReference Include="Microsoft.AspNet.Mvc" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.WebHost" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.Web.Optimization" Version="1.1.3" />
    <PackageReference Include="Swashbuckle.Core" Version="5.6.0" />
  </ItemGroup>

  <UsingTask TaskName="WebForCoreIisWebConfig" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <WebConfig ParameterType="System.String" Required="true" />
      <AssemblyConfig ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // The sample's Web.config plus the <runtime> (assembly binding redirects) the build generated for the packages.
        XDocument config = XDocument.Load(WebConfig);
        config.Root.Elements("runtime").Remove();
        if (File.Exists(AssemblyConfig))
        {
            XElement runtime = XDocument.Load(AssemblyConfig).Root.Element("runtime");
            if (runtime != null) config.Root.Add(runtime);
        }
        Directory.CreateDirectory(Path.GetDirectoryName(Output));
        config.Save(Output);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WriteIisSite" AfterTargets="Build">
    <ItemGroup>
      <_IisBin Include="$(OutDir)*.dll;$(OutDir)*.pdb;$(OutDir)*.xml" />
      <_IisFiles Include="$(Sample)**\*.aspx;$(Sample)**\*.js;$(Sample)**\*.css" Exclude="$(Sample)bin_dotnet\**;$(Sample)obj\**;$(Sample)bin\**" />
    </ItemGroup>
    <Copy SourceFiles="@(_IisBin)" DestinationFolder="$(IisSiteDirectory)bin" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_IisFiles)" DestinationFiles="@(_IisFiles->'$(IisSiteDirectory)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(Sample)Global.asax" DestinationFolder="$(IisSiteDirectory)" SkipUnchangedFiles="true" />
    <WebForCoreIisWebConfig WebConfig="$(Sample)Web.config" AssemblyConfig="$(TargetPath).config" Output="$(IisSiteDirectory)Web.config" />
    <Message Importance="high" Text="IIS site: $(IisSiteDirectory)" />
  </Target>
</Project>
