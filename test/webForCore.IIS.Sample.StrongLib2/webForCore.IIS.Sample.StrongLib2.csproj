<Project Sdk="Microsoft.NET.Sdk">

  <!-- #158: StrongLib 2.0.0.0, the same source and key as webForCore.IIS.Sample.StrongLib (1.0.0.0). StrongUser is built
       against it; the IIS sample deploys only 1.0.0.0. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>StrongLib</AssemblyName>
    <RootNamespace>StrongLib</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\src\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
    <IsPackable>false</IsPackable>
    <OutputPath>bin_dotnet</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\webForCore.IIS.Sample.StrongLib\Greeting.cs" />
  </ItemGroup>
</Project>
