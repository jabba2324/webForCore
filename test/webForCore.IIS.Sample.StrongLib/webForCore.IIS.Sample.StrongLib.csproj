<Project Sdk="Microsoft.NET.Sdk">

  <!-- #158: a strong-named assembly, version 1.0.0.0, which the IIS sample deploys (it is in its deps.json and
       bin_dotnet). StrongUser was built against version 2.0.0.0 (webForCore.IIS.Sample.StrongLib2, the same source), and
       the sample's Web.config redirects 0.0.0.0-2.5.0.0 and 4.0.0.0 to 1.0.0.0, as a customer application's Web.config
       redirects references to a lower version than they were built against. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>StrongLib</AssemblyName>
    <RootNamespace>StrongLib</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\src\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
    <IsPackable>false</IsPackable>
    <OutputPath>bin_dotnet</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
