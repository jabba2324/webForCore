<Project Sdk="Microsoft.NET.Sdk">

  <!-- #158: a strong-named assembly, version 1.0.0.0, that applications don't reference. The IIS sample's build copies
       it to bin_dotnet/codebase, which its Web.config names in a <codeBase>, a folder fusion doesn't probe; Host.Tests
       puts it outside the site and names it with a file: URL. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>CodeBaseLib</AssemblyName>
    <RootNamespace>CodeBaseLib</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>..\..\src\SigningKey\WebFormsForCore.snk</AssemblyOriginatorKeyFile>
    <IsPackable>false</IsPackable>
    <OutputPath>bin_dotnet</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
