    <Compile Include="$(MpTests)FunctionalTests/BaseProviderAsyncTest/MockCommand.cs" Link="FunctionalTests/BaseProviderAsyncTest/MockCommand.cs" />
    <Compile Include="$(MpTests)FunctionalTests/BaseProviderAsyncTest/MockConnection.cs" Link="FunctionalTests/BaseProviderAsyncTest/MockConnection.cs" />
    <Compile Include="$(MpTests)FunctionalTests/BaseProviderAsyncTest/MockDataReader.cs" Link="FunctionalTests/BaseProviderAsyncTest/MockDataReader.cs" />
    <Compile Include="$(MpTests)FunctionalTests/SqlCredentialTest.cs" Link="FunctionalTests/SqlCredentialTest.cs" />
    <Compile Include="$(MpTests)FunctionalTests/AmbientTransactionFailureTest.cs" Link="FunctionalTests/AmbientTransactionFailureTest.cs" />
    <Compile Include="$(MpTests)FunctionalTests/SqlBulkCopyColumnMappingCollectionTest.cs" Link="FunctionalTests/SqlBulkCopyColumnMappingCollectionTest.cs" />
    <Compile Include="$(MpTests)FunctionalTests/SqlDataRecordTest.cs" Link="FunctionalTests/SqlDataRecordTest.cs" />
    <Compile Include="$(MpTests)FunctionalTests/SqlMetaDataTest.cs" Link="FunctionalTests/SqlMetaDataTest.cs" />
