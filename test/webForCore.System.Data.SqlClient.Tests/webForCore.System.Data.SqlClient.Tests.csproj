    <Compile Include="$(MpTests)FunctionalTests/SqlErrorCollectionTest.cs" Link="FunctionalTests/SqlErrorCollectionTest.cs" />
    <Compile Include="$(MpTests)FunctionalTests/SqlFacetAttributeTest.cs" Link="FunctionalTests/SqlFacetAttributeTest.cs" />
    <!-- Upstream builds it as its own assembly (ManualTests/SQL/UdtTest/UDTs/Address/Address.csproj). -->
    <Compile Include="$(MpTests)ManualTests/SQL/UdtTest/UDTs/Address/Address.cs" Link="UDTs/Address.cs" />
    <Compile Include="../../external/maintenance-packages/src/Common/tests/TestUtilities/System/AssertExtensions.cs" Link="Common/System/AssertExtensions.cs" />
    <Compile Include="AssemblyTests.cs" />
  </ItemGroup>

  <ItemGroup>
