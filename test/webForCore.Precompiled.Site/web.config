<?xml version="1.0" encoding="utf-8"?>
<!-- A Web Forms site for the precompilation gate (test/webForCore.IIS.Gate.Tests/PrecompilationTests.cs): pages with
     CodeFile code-behind, a master page, a user control, App_Code, Global.asax and global resources. -->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>
</configuration>
