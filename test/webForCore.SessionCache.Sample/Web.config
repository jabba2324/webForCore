<?xml version="1.0" encoding="utf-8"?>
<!-- In process, as built. test/webForCore.SessionCache.Gate.Tests runs copies of this folder with one of configs/*.config as
     their Web.config. -->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
  </system.web>
</configuration>
