<?xml version="1.0" encoding="utf-8"?>
<!-- Two applications on one machine, or one application on two servers, told apart by WebForCore:Host:SiteId (#210):
     System.Web's SQL Server session state (keyed by HttpRuntime.AppDomainAppId) and a <machineKey> whose keys are
     IsolateByAppId (on explicit keys, Framework20SP1 takes the modifier: a hash of the application's ID replaces some of
     the key's bytes). The gate replaces %SQL% with the server's connection string. -->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <machineKey validation="SHA1" decryption="AES" compatibilityMode="Framework20SP1"
                validationKey="0A1B2C3D4E5F60718293A4B5C6D7E8F90A1B2C3D4E5F60718293A4B5C6D7E8F9F9E8D7C6B5A4938271605F4E3D2C1B0AF9E8D7C6B5A4938271605F4E3D2C1B0A,IsolateByAppId"
                decryptionKey="1F2E3D4C5B6A79880F1E2D3C4B5A69781F2E3D4C5B6A79880F1E2D3C4B5A6978,IsolateByAppId" />
    <sessionState mode="SQLServer" sqlConnectionString="%SQL%" allowCustomSqlDatabase="true" />
  </system.web>
</configuration>
