<?xml version="1.0" encoding="utf-8"?>
<!-- #185: session state out of process on IIS (StateServer), which UseAspNetCoreSessionProvider()
     (SESSIONCACHE_ASPNETCORE_SESSION=1) replaces; still off where a page, a controller or <pages enableSessionState="false">
     turns it off. -->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <sessionState mode="StateServer" stateConnectionString="tcpip=127.0.0.1:42424" />
  </system.web>
  <location path="PagesOff">
    <system.web>
      <pages enableSessionState="false" />
    </system.web>
  </location>
</configuration>
