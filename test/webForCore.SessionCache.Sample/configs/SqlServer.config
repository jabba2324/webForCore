<?xml version="1.0" encoding="utf-8"?>
<!-- System.Web's own SQL Server session state (SqlSessionStateStore), in the database webforcore-regsql -ssadd made
     (ASPState, -sstype p). The gate replaces %SQL% with the server's connection string. -->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <sessionState mode="SQLServer" sqlConnectionString="%SQL%" allowCustomSqlDatabase="true" />
  </system.web>
</configuration>
