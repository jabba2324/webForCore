<?xml version="1.0" encoding="utf-8"?>
<!-- #185: session state turned off, in an application whose Program.cs calls UseAspNetCoreSessionProvider()
     (SESSIONCACHE_ASPNETCORE_SESSION=1). As on IIS, mode="Off" wins: no session state, no session cookie. -->
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <sessionState mode="Off" />
  </system.web>
</configuration>
