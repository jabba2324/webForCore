<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- linq/: LinqDataSource over LINQ to SQL (LinqDataSourceTests), against the SQL Server of the other data tests
         (127.0.0.1,14333: tools/ci/sqlserver.sh, or SQL Server Express on Windows: tools/ci/sqlserver-windows.ps1). -->
    <add name="LinqCatalog" connectionString="Data Source=127.0.0.1,14333;Initial Catalog=WebForCoreLinqGate;User ID=sa;Password=webForCore-Test1!;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="false" targetFramework="4.8">
      <assemblies>
        <!-- App_Code/LinqCatalog.cs: on .NET Framework, System.Data.Linq is in the GAC but not in the root Web.config's list. -->
        <add assembly="System.Data.Linq, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
      </assemblies>
    </compilation>
    <httpRuntime targetFramework="4.8" />
    <!-- #129: an anonymous 401 becomes the redirect to the log-in page (FormsAuthenticationModule, EndRequest). -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" />
    </authentication>
    <httpModules>
      <!-- The classic pipeline's list (IIS's classic application pool, webForCore). -->
      <add name="EndRequestHeader" type="EndRequestModule" />
    </httpModules>
  </system.web>
  <system.webServer>
    <!-- The module is listed for both pipelines, so IIS's integrated pipeline must not reject system.web's list. -->
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <!-- Marks the responses under /end/ in EndRequest, to show that EndRequest ran and could still change them. -->
      <add name="EndRequestHeader" type="EndRequestModule" />
    </modules>
  </system.webServer>
</configuration>
