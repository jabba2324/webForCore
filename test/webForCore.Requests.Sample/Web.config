<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- #129: an anonymous 401 becomes the redirect to the log-in page (FormsAuthenticationModule, EndRequest). -->
    <authentication mode="Forms">
      <forms loginUrl="~/Login.aspx" />
    </authentication>
    <httpModules>
      <!-- The classic pipeline's list (IIS's classic application pool, webForCore). -->
      <add name="EndRequestHeader" type="EndRequestModule" />
    </httpModules>
  </system.web>
  <system.webServer>
    <!-- The module is listed for both pipelines, so IIS's integrated pipeline must not reject system.web's list. -->
    <validation validateIntegratedModeConfiguration="false" />
    <modules>
      <!-- Marks the responses under /end/ in EndRequest, to show that EndRequest ran and could still change them. -->
      <add name="EndRequestHeader" type="EndRequestModule" />
    </modules>
  </system.webServer>
</configuration>
