<?xml version="1.0" encoding="utf-8"?>
<!-- #192: maxRequestLength (8 KB, 8192 bytes) below maxAllowedContentLength (16384 bytes): a body between the two reaches the application, and ASP.NET throws "Maximum request length exceeded" when it reads it. -->
<configuration>
  <system.web>
    <httpRuntime maxRequestLength="8" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="16384" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
