<?xml version="1.0" encoding="utf-8"?>
<!-- #192: requestLengthDiskThreshold (16 KB): a body over it is buffered to a file in the compilation folder's uploads folder. -->
<configuration>
  <system.web>
    <httpRuntime maxRequestLength="64" requestLengthDiskThreshold="16" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="30000000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
