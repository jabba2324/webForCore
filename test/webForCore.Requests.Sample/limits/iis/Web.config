<?xml version="1.0" encoding="utf-8"?>
<!-- #192: maxAllowedContentLength (8192 bytes) below maxRequestLength (16 KB): a body between the two is request filtering's 404.13, before the application runs. -->
<configuration>
  <system.web>
    <httpRuntime maxRequestLength="16" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="8192" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
