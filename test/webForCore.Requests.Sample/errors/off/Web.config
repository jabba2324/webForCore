<?xml version="1.0" encoding="utf-8"?>
<!-- #192: customErrors off: the detailed error page, whatever the pages. -->
<configuration>
  <system.web>
    <customErrors mode="Off" defaultRedirect="~/errors/Oops.aspx">
      <error statusCode="404" redirect="~/errors/NotFound.aspx" />
    </customErrors>
  </system.web>
</configuration>
