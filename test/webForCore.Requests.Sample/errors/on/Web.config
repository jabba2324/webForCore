<?xml version="1.0" encoding="utf-8"?>
<!-- #192: customErrors on, with a default page and one for 404 (redirectMode ResponseRedirect, the default). -->
<configuration>
  <system.web>
    <customErrors mode="On" defaultRedirect="~/errors/Oops.aspx">
      <error statusCode="404" redirect="~/errors/NotFound.aspx" />
    </customErrors>
  </system.web>
</configuration>
