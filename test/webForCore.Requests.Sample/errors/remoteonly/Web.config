<?xml version="1.0" encoding="utf-8"?>
<!-- #192: customErrors for remote requests only: the comparison's requests are local, so they get the detailed error page. -->
<configuration>
  <system.web>
    <customErrors mode="RemoteOnly" defaultRedirect="~/errors/Oops.aspx">
      <error statusCode="404" redirect="~/errors/NotFound.aspx" />
    </customErrors>
  </system.web>
</configuration>
