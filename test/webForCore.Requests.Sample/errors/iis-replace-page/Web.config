<?xml version="1.0" encoding="utf-8"?>
<!-- #192: IIS's custom errors (httpErrors) with existingResponse Replace with a page as the 500 page (ExecuteURL): the page runs as a child request and its status is the response's. -->
<configuration>
  <system.web>
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="500" />
      <error statusCode="500" path="/errors/IisError.aspx" responseMode="ExecuteURL" />
      <remove statusCode="404" />
      <error statusCode="404" path="/errors/iis404.htm" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
