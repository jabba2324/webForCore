<?xml version="1.0" encoding="utf-8"?>
<!-- #219: request filtering's rejections (404.5, 404.6, 404.7, 404.8, 404.10, 404.11, 404.14, 404.15, 404.18 and 413.1) and
     the MIME map's 404.3, answered by IIS's own error pages: whether IIS closes the connection after each. -->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="100" maxUrl="200" maxQueryString="50">
          <headerLimits>
            <add header="X-Big" sizeLimit="10" />
          </headerLimits>
        </requestLimits>
        <verbs>
          <add verb="DELETE" allowed="false" />
        </verbs>
        <fileExtensions>
          <add fileExtension=".forbidden" allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence="blocked" />
        </denyUrlSequences>
        <denyQueryStringSequences>
          <add sequence="blockedq" />
        </denyQueryStringSequences>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
