<?xml version="1.0" encoding="utf-8"?>
<!-- #219: as filtering, with <httpErrors errorMode="Custom"> answering every 404 and 413 by an ExecuteURL page, as
     iis-hidden does: whether IIS closes the connection after the page. -->
<configuration>
  <system.web>
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="100" maxUrl="200" maxQueryString="50">
          <headerLimits>
            <add header="X-Big" sizeLimit="10" />
          </headerLimits>
        </requestLimits>
        <verbs>
          <add verb="DELETE" allowed="false" />
        </verbs>
        <fileExtensions>
          <add fileExtension=".forbidden" allowed="false" />
        </fileExtensions>
        <denyUrlSequences>
          <add sequence="blocked" />
        </denyUrlSequences>
        <denyQueryStringSequences>
          <add sequence="blockedq" />
        </denyQueryStringSequences>
      </requestFiltering>
    </security>
    <httpErrors errorMode="Custom">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" prefixLanguageFilePath="" path="/errors/IisError.aspx" responseMode="ExecuteURL" />
      <error statusCode="413" prefixLanguageFilePath="" path="/errors/IisError.aspx" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
