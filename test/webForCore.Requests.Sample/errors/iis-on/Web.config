<?xml version="1.0" encoding="utf-8"?>
<!-- #192: customErrors on and httpErrors with existingResponse Replace: customErrors redirects first, so httpErrors sees a 302. -->
<configuration>
  <system.web>
    <customErrors mode="On" defaultRedirect="~/errors/Oops.aspx">
      <error statusCode="404" redirect="~/errors/NotFound.aspx" />
    </customErrors>
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="500" />
      <error statusCode="500" path="/errors/iis500.htm" responseMode="ExecuteURL" />
      <remove statusCode="404" />
      <error statusCode="404" path="/errors/iis404.htm" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
