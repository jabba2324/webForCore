<?xml version="1.0" encoding="utf-8"?>
<!-- IIS's custom errors (httpErrors) for request filtering's 404.8 (a hidden segment: App_Data), as Subtext's Web.config has them (errorMode="Custom", every 404 to a page by ExecuteURL): IIS answers 404.8 before any module runs, then the page runs as a child request, and the response is the child request's. -->
<configuration>
  <system.web>
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" prefixLanguageFilePath="" path="/errors/IisError.aspx" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
