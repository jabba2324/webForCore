<?xml version="1.0" encoding="utf-8"?>
<!-- #192: customErrors on with redirectMode ResponseRewrite: the error page is executed in place of the response, at the same URL. -->
<configuration>
  <system.web>
    <customErrors mode="On" defaultRedirect="~/errors/Oops.aspx" redirectMode="ResponseRewrite">
      <error statusCode="404" redirect="~/errors/NotFound.aspx" />
    </customErrors>
  </system.web>
</configuration>
