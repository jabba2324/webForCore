<?xml version="1.0" encoding="utf-8"?>
<!-- As iis-hidden, with an error page that redirects permanently, as Subtext's BlogRequestModule does when the error page's URL names a blog subfolder that isn't the blog's: the child request's 301 is the response. -->
<configuration>
  <system.web>
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" prefixLanguageFilePath="" path="/errors/Moved.aspx" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
