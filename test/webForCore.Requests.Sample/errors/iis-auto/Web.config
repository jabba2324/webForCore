<?xml version="1.0" encoding="utf-8"?>
<!-- #192: IIS's custom errors (httpErrors) with existingResponse Auto: a response with TrySkipIisCustomErrors passes through, others are replaced. -->
<configuration>
  <system.web>
    <customErrors mode="Off" />
  </system.web>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="500" />
      <error statusCode="500" path="/errors/iis500.htm" responseMode="ExecuteURL" />
      <remove statusCode="404" />
      <error statusCode="404" path="/errors/iis404.htm" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
