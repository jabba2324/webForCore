<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Request handling compared with IIS 10 (#126, #127, #129, #140): a Web Forms site of pages, App_Code and static
       files only, nothing compiled into bin, so that IIS serves the same folder as it is. Here, on Kestrel, the fork's
       System.Web serves it; test/webForCore.IIS.Gate.Tests (RequestHandlingTests) drives it and records each response in
       requests-responses.json, and CI's iis-compare job sends the same requests to this folder on IIS 10 and diffs the
       two (tools/ci/iis_compare.cs). Program.cs is the Kestrel entry point; IIS doesn't compile it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The fork serves the parent of the output folder (WebFormsMiddleware: PhysicalPath), as in the TestApp. -->
    <OutputPath>bin_dotnet</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\src\webForCore.WebStack.targets" />

  <ItemGroup>
    <!-- App_Code and the pages are compiled at run time from the app folder, as on IIS. -->
    <Compile Remove="App_Code\**" />
    <Content Remove="bin_dotnet\**" />
    <None Remove="bin_dotnet\**" />
    <Compile Remove="bin_dotnet\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebFormsForCore.Configuration\WebFormsForCore.Configuration.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.ApplicationServices\WebFormsForCore.Web.ApplicationServices.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.RegularExpressions\WebFormsForCore.Web.RegularExpressions.csproj" />
    <!-- machine.config lists System.Web.Services and System.Web.Extensions (ScriptModule); the app deploys them. -->
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Services\WebFormsForCore.Web.Services.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Extensions\WebFormsForCore.Web.Extensions.csproj" />
    <!-- In the "Always" set (MIGRATING.md): linq/DynamicData.aspx registers a LINQ to SQL DataContext with Dynamic Data. -->
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.DynamicData\WebFormsForCore.Web.DynamicData.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Infrastructure\WebFormsForCore.Web.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Abstractions\WebFormsForCore.Web.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Routing\WebFormsForCore.Web.Routing.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Compilers\WebFormsForCore.Compilers.csproj" />
  </ItemGroup>
</Project>
