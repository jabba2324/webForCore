<%@ Page Language="C#" %>
<script runat="server">
    // LinqDataSource over a LINQ to SQL DataContext (App_Code/LinqCatalog.cs) with Where, OrderBy, paging and sorting
    // by the data source (AutoPage, AutoSort), and update, insert and delete through a GridView and a DetailsView.
    // Its events write to Log what they were given, for LinqDataSourceTests.
    private void Write(string text)
    {
        Log.Text += HttpUtility.HtmlEncode(text) + ";";
    }

    protected void ProductsSource_Selecting(object sender, LinqDataSourceSelectEventArgs e)
    {
        Write("selecting sort=" + e.Arguments.SortExpression + " start=" + e.Arguments.StartRowIndex + " max=" + e.Arguments.MaximumRows
            + " count=" + e.Arguments.RetrieveTotalRowCount + " min=" + e.WhereParameters["MinPrice"]);
    }

    protected void ProductsSource_Selected(object sender, LinqDataSourceStatusEventArgs e)
    {
        Write("selected total=" + e.TotalRowCount);
    }

    protected void ProductsSource_Updating(object sender, LinqDataSourceUpdateEventArgs e)
    {
        var original = (LinqProduct)e.OriginalObject;
        var updated = (LinqProduct)e.NewObject;
        Write("updating " + original.ProductName + " -> " + updated.ProductName + " " + updated.UnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)
            + " version=" + (original.Version != null && updated.Version != null && original.Version.Equals(updated.Version) && original.Version.Length == 8));
    }

    protected void ProductsSource_Updated(object sender, LinqDataSourceStatusEventArgs e)
    {
        if (e.Exception != null)
        {
            Write("update failed: " + e.Exception.GetType().FullName + ": " + e.Exception.Message);
            e.ExceptionHandled = true;
        }
        else
        {
            Write("updated " + ((LinqProduct)e.Result).ProductName);
        }
    }

    protected void ProductsSource_Inserted(object sender, LinqDataSourceStatusEventArgs e)
    {
        var product = (LinqProduct)e.Result;
        Write("inserted " + product.ProductName + " id=" + product.ProductID + " version=" + (product.Version != null && product.Version.Length == 8));
    }

    protected void ProductsSource_Deleted(object sender, LinqDataSourceStatusEventArgs e)
    {
        Write(e.Exception != null ? "delete failed: " + e.Exception.GetType().FullName : "deleted " + ((LinqProduct)e.Result).ProductName);
    }
</script>
<!DOCTYPE html>
<html>
<head><title>LinqDataSource</title></head>
<body>
<form id="form1" runat="server">
    <asp:LinqDataSource ID="ProductsSource" runat="server" ContextTypeName="LinqCatalogDataContext" TableName="Products"
        Where="UnitPrice >= @MinPrice" OrderBy="ProductName" EnableUpdate="true" EnableInsert="true" EnableDelete="true"
        OnSelecting="ProductsSource_Selecting" OnSelected="ProductsSource_Selected" OnUpdating="ProductsSource_Updating"
        OnUpdated="ProductsSource_Updated" OnInserted="ProductsSource_Inserted" OnDeleted="ProductsSource_Deleted">
        <WhereParameters>
            <asp:QueryStringParameter Name="MinPrice" QueryStringField="min" Type="Decimal" DefaultValue="0" />
        </WhereParameters>
    </asp:LinqDataSource>
    <asp:GridView ID="Grid" runat="server" DataSourceID="ProductsSource" DataKeyNames="ProductID" AutoGenerateColumns="false"
        AllowPaging="true" PageSize="3" AllowSorting="true" AutoGenerateEditButton="true" AutoGenerateDeleteButton="true">
        <Columns>
            <asp:BoundField DataField="ProductID" HeaderText="ID" ReadOnly="true" SortExpression="ProductID" />
            <asp:BoundField DataField="ProductName" HeaderText="Name" SortExpression="ProductName" />
            <asp:BoundField DataField="CategoryID" HeaderText="Category" />
            <asp:BoundField DataField="UnitPrice" HeaderText="Price" DataFormatString="{0:0.00}" SortExpression="UnitPrice" />
            <asp:CheckBoxField DataField="Discontinued" HeaderText="Discontinued" />
        </Columns>
    </asp:GridView>
    <asp:DetailsView ID="NewProduct" runat="server" DataSourceID="ProductsSource" DefaultMode="Insert" AutoGenerateRows="false"
        AutoGenerateInsertButton="true">
        <Fields>
            <asp:BoundField DataField="ProductName" HeaderText="Name" />
            <asp:BoundField DataField="CategoryID" HeaderText="Category" />
            <asp:BoundField DataField="UnitPrice" HeaderText="Price" />
            <asp:CheckBoxField DataField="Discontinued" HeaderText="Discontinued" />
        </Fields>
    </asp:DetailsView>
    <p>Log: <asp:Label ID="Log" runat="server" EnableViewState="false" /></p>
</form>
</body>
</html>
