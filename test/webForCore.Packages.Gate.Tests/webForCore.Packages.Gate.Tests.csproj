<Project Sdk="Microsoft.NET.Sdk">

  <!-- The third-party packages gate: test/webForCore.Packages.Sample (Ninject's web integration, Swashbuckle.Core and
       CacheCow.Server.WebApi, the original net45/net40/net452 packages) under webforcore-host. The requests are sent in
       a fixed order and every response is written to packages-responses.json, which CI's iis-compare job sends again to
       the same sample on IIS 10 (test/webForCore.Packages.Sample.Iis, Microsoft's packages) and compares. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- Built and run, not referenced. -->
    <ProjectReference Include="..\webForCore.Packages.Sample\webForCore.Packages.Sample.csproj" ReferenceOutputAssembly="false" />
    <!-- The samples run under webforcore-host (#56), from its build here. -->
    <ProjectReference Include="..\..\src\WebFormsForCore.Host\WebFormsForCore.Host.csproj" ReferenceOutputAssembly="false" />
    <Compile Include="..\Shared\WebForCoreHost.cs" Link="WebForCoreHost.cs" />
  </ItemGroup>
</Project>
