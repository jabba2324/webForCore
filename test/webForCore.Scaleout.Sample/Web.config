<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <!-- One watcher of the site folder (#146): the tests run four processes at once on machines with a limit on inotify
         instances. -->
    <httpRuntime targetFramework="4.8" fcnMode="Single" />
    <!-- Every instance of a web farm has the same keys, as on IIS: SignalR protects its connection tokens and group lists
         with them (MachineKey through Katana's data protection), so a token one instance gave must read on another, and
         on an instance after its restart. -->
    <machineKey validationKey="6D7ECF628BFD9A180F2F4A2F9028C41DA5A2CA9302A8B99524BE9C4645C69A546BFA2BB115FC57DFECE4AA5054FA290BC932C848B1B5A61900138C3A2F5174A2"
                decryptionKey="9E5EC7846DBF2CDD0C5C9284A24341A92ECFAFF24E420F5717BDFE16CFADB972" validation="HMACSHA256" decryption="AES" />
  </system.web>
</configuration>
