<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <handlers>
      <!-- As in the Visual Studio "Web API" template. -->
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
  <!-- <system.diagnostics> (#213): trace listeners, sources, shared listeners and switches, as .NET Framework's
       System.Diagnostics reads them from Web.config. WebApi.Gate.Tests' TracingTests and SystemDiagnosticsTests check
       what they create (TraceController), and CI's iis-compare job the same requests on IIS 10. The listener
       "webconfig" gets Web API's trace records ("Tracing in ASP.NET Web API 2" suggests a listener in Web.config for a
       log), beside the one Application_Start adds. -->
  <system.diagnostics>
    <assert assertuienabled="false" />
    <trace autoflush="true" indentsize="2">
      <listeners>
        <add name="webconfig" type="WebApiSample.TraceRecordListener, webForCore.WebApi.Sample" initializeData="webconfig" />
        <add name="filtered" type="WebApiSample.TraceRecordListener, webForCore.WebApi.Sample" initializeData="filtered"
             traceOutputOptions="DateTime, ThreadId" category="warnings">
          <filter type="System.Diagnostics.EventTypeFilter" initializeData="Warning" />
        </add>
      </listeners>
    </trace>
    <sources>
      <!-- switchValue; the source's own listener and a shared one, without the default listener. -->
      <source name="WebApiSample.Orders" switchValue="Warning">
        <listeners>
          <remove name="Default" />
          <add name="orders" type="WebApiSample.TraceRecordListener, webForCore.WebApi.Sample" initializeData="orders" />
          <add name="shared" />
        </listeners>
      </source>
      <!-- switchName and switchType: the switch <switches> sets. -->
      <source name="WebApiSample.Payments" switchName="PaymentsSwitch" switchType="System.Diagnostics.SourceSwitch">
        <listeners>
          <clear />
          <add name="shared" />
        </listeners>
      </source>
      <!-- An attribute, which the source's type (SampleTraceSource) supports. -->
      <source name="WebApiSample.Custom" switchValue="All" owner="sample">
        <listeners>
          <add name="shared" />
        </listeners>
      </source>
      <!-- Listeners that write files under this folder (Logs, which TraceController creates). -->
      <source name="WebApiSample.Files" switchValue="Information">
        <listeners>
          <clear />
          <add name="text" />
          <add name="delimited" />
          <add name="xml" />
        </listeners>
      </source>
      <source name="WebApiSample.EventLog" switchValue="Information">
        <listeners>
          <clear />
          <add name="eventlog" type="System.Diagnostics.EventLogTraceListener" initializeData="WebApiSample" />
        </listeners>
      </source>
      <!-- A listener whose type doesn't exist. -->
      <source name="WebApiSample.Broken" switchValue="Information">
        <listeners>
          <add name="broken" type="WebApiSample.NoSuchListener, webForCore.WebApi.Sample" />
        </listeners>
      </source>
    </sources>
    <sharedListeners>
      <add name="shared" type="WebApiSample.TraceRecordListener, webForCore.WebApi.Sample" initializeData="shared" />
      <add name="text" type="System.Diagnostics.TextWriterTraceListener" initializeData="Logs/text.log" />
      <add name="delimited" type="System.Diagnostics.DelimitedListTraceListener" initializeData="Logs/delimited.log"
           delimiter="|" traceOutputOptions="ProcessId" />
      <add name="xml" type="System.Diagnostics.XmlWriterTraceListener, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
           initializeData="Logs/trace.svclog" />
    </sharedListeners>
    <switches>
      <add name="PaymentsSwitch" value="Error" />
      <add name="WebApiSample.Enabled" value="true" />
      <add name="WebApiSample.Level" value="Warning" />
      <add name="WebApiSample.Owned" value="3" owner="sample" />
    </switches>
  </system.diagnostics>
</configuration>
