<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- RegressionTests (#147): the folders fusion probes after bin, as Orchard 1.x names App_Data/Dependencies. The
       first doesn't exist, the second has ProbedLib.dll (regressions/Probing.aspx), and the third is outside the site,
       which fusion doesn't probe.
       #158 (regressions/BindingRedirects.aspx): StrongLib 1.0.0.0 is deployed, and references to 0.0.0.0-2.5.0.0 and
       4.0.0.0 bind to it; CodeBaseLib 1.0.0.0 is in a folder fusion doesn't probe, named by a <codeBase>. An
       <assemblyBinding> for another runtime (appliesTo) doesn't apply, and an assembly without a strong name loads
       from a <codeBase> only in the application's folder. -->
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="App_Data/NoSuchFolder;bin_dotnet\probed;../webForCore.IIS.Sample.Unprobed/bin_dotnet" />
      <dependentAssembly>
        <assemblyIdentity name="StrongLib" publicKeyToken="6b8e2037dda5564b" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.5.0.0" newVersion="1.0.0.0" />
        <bindingRedirect oldVersion="4.0.0.0" newVersion="1.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="CodeBaseLib" publicKeyToken="6b8e2037dda5564b" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-0.9.9.9" newVersion="1.0.0.0" />
        <codeBase version="1.0.0.0" href="bin_dotnet/codebase/CodeBaseLib.dll" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="UnprobedLib" />
        <codeBase href="../webForCore.IIS.Sample.Unprobed/bin_dotnet/UnprobedLib.dll" />
      </dependentAssembly>
    </assemblyBinding>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1" appliesTo="v2.0.50727">
      <dependentAssembly>
        <assemblyIdentity name="StrongLib" publicKeyToken="6b8e2037dda5564b" culture="neutral" />
        <bindingRedirect oldVersion="3.0.0.0" newVersion="1.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <!-- ADO.NET providers, as machine.config and web.config declared them on .NET Framework (data/Providers.aspx). -->
  <system.data>
    <DbProviderFactories>
      <add name="Gate provider" invariant="WebForCore.Gate" description="A provider declared by the application" type="IISSample.GateDbProviderFactory, webForCore.IIS.Sample" />
      <remove invariant="System.Data.OleDb" />
    </DbProviderFactories>
  </system.data>
  <!-- App_Code/CatalogData.xsd's TableAdapters (data/TypedDataSet.aspx): the SQL Server tools/ci/sqlserver.sh starts. -->
  <connectionStrings>
    <add name="CatalogConnectionString" connectionString="Data Source=127.0.0.1,14333;Initial Catalog=WebForCoreCatalog;User ID=sa;Password=webForCore-Test1!;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
    <!-- #123: machine.config's LocalSqlServer (SQL Express's aspnetdb.mdf, which can't exist off Windows) pointed at a
         SQL Server, as MIGRATING.md says; its AspNetSql providers then use the database webforcore-regsql creates
         (regressions/SqlServices.aspx). -->
    <remove name="LocalSqlServer" />
    <add name="LocalSqlServer" connectionString="Data Source=127.0.0.1,14333;Initial Catalog=WebForCoreAspNetDb;User ID=sa;Password=webForCore-Test1!;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.net>
    <!-- The proxy of HttpClient and WebClient (net/Proxy.aspx); the gate runs one on this port. -->
    <defaultProxy>
      <proxy proxyaddress="http://127.0.0.1:31280" bypassonlocal="true" />
      <bypasslist>
        <add address="skip\.example\.invalid" />
      </bypasslist>
    </defaultProxy>
    <!-- System.Web's mail senders (mail/Send.aspx, mail/Recover.aspx); the gate runs an SMTP server on this port. -->
    <mailSettings>
      <smtp from="noreply@example.com">
        <network host="127.0.0.1" port="2525" />
      </smtp>
    </mailSettings>
  </system.net>
  <!-- RegressionTests (#88): the compilers .NET 3.5/4.0 project templates named, .NET Framework's own providers in
       System 2.0.0.0, as Umbraco 6.2.6's Web.config has them. They compile every page of this sample. -->
  <system.codedom>
    <compilers>
      <compiler language="c#;cs;csharp" extension=".cs" warningLevel="4" type="Microsoft.CSharp.CSharpCodeProvider, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
        <providerOption name="CompilerVersion" value="v4.0" />
        <providerOption name="WarnAsError" value="false" />
      </compiler>
      <compiler language="vb;vbs;visualbasic;vbscript" extension=".vb" warningLevel="4" type="Microsoft.VisualBasic.VBCodeProvider, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
        <providerOption name="CompilerVersion" value="v4.0" />
        <providerOption name="OptionInfer" value="true" />
        <providerOption name="WarnAsError" value="false" />
      </compiler>
    </compilers>
  </system.codedom>
  <system.web>
    <!-- debug="false": ASP.NET times requests out (executionTimeout) only without debugging. -->
    <compilation debug="false" targetFramework="4.8" />
    <!-- shutdownTimeout: how long a restart waits for the old domain's requests (90 s by default) before it refuses any
         that are still to start; in the classic pipeline it then waits for those running, on IIS (CI's iis-compare job)
         and on webForCore. Short, so that the gate sees a request run past it
         (RecyclingTests.ARequestRunningAcrossARestartRunsToItsEnd, #181). -->
    <httpRuntime targetFramework="4.8" shutdownTimeout="5" />
    <customErrors mode="Off" />
    <!-- RegressionTests (#184): an output cache provider of the application's own, for the pages Global.asax's
         GetOutputCacheProviderName gives it (regressions/unbuffered/Cached.aspx?provider=1); the default stays. -->
    <caching>
      <outputCache>
        <providers>
          <add name="GateOutputCache" type="GateOutputCacheProvider" />
        </providers>
      </outputCache>
    </caching>
    <!-- RegressionTests (#87): a partial trust level, as Umbraco 6's development web.config and many hosting-era
         applications set it. webForCore ignores it and runs the application in full trust; it made every request a
         Configuration Error ("Unable to read the security policy file for trust level 'Medium'"). -->
    <trust level="Medium" originUrl=".*" />
    <!-- How long a restart waits for the application's registered objects (default 30 s), not for its requests, which
         <httpRuntime shutdownTimeout> governs (90 s): short, so that the gate sees a request run past it
         (RecyclingTests.ARequestRunningAcrossARestartRunsToItsEnd, #181). -->
    <hostingEnvironment shutdownTimeout="5" />
    <!-- machine.config's SqlMembershipProvider and SqlRoleProvider on LocalSqlServer (#123, regressions/SqlServices.aspx),
         and a member for the login controls that send mail (mail/Recover.aspx). -->
    <membership defaultProvider="AspNetSqlMembershipProvider">
      <providers>
        <add name="Gate" type="IISSample.GateMembershipProvider" />
      </providers>
    </membership>
    <roleManager enabled="true" />
  </system.web>
  <system.webServer>
    <modules>
      <!-- A managed module registered the integrated-mode way, and one of ASP.NET's removed. -->
      <add name="GateModule" type="GateModule" />
      <add name="IntegratedModule" type="IntegratedModule" />
      <remove name="Session" />
    </modules>
    <handlers>
      <add name="GateHandler" path="gate.axd" verb="GET,HEAD" type="GateHandler" />
      <!-- RegressionTests (#12): paths that start with '/', as MiniBlog maps /metaweblog and /feed/*. -->
      <add name="RegressionSlashHandler" path="/regressions/handler/*" verb="GET" type="GateHandler" />
      <add name="RegressionSlashExactHandler" path="/regressions/exact-handler" verb="GET" type="GateHandler" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <add name="X-Gate-Header" value="iis" />
      </customHeaders>
      <redirectHeaders>
        <add name="X-Gate-Redirect" value="yes" />
      </redirectHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".secret" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="private" />
        </hiddenSegments>
        <verbs>
          <add verb="TRACE" allowed="false" />
        </verbs>
        <denyUrlSequences>
          <add sequence="forbidden-sequence" />
        </denyUrlSequences>
        <requestLimits maxQueryString="100" />
      </requestFiltering>
    </security>
    <staticContent>
      <mimeMap fileExtension=".gate" mimeType="text/x-gate" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="errors\404.htm" responseMode="File" />
      <error statusCode="404" subStatusCode="7" path="errors\denied.htm" responseMode="File" />
      <error statusCode="500" path="/Error.aspx" responseMode="ExecuteURL" />
    </httpErrors>
    <rewrite>
      <rules>
        <rule name="Products">
          <match url="^products/([0-9]+)$" />
          <action type="Rewrite" url="Product.aspx?id={R:1}" />
        </rule>
        <rule name="Legacy" stopProcessing="true">
          <match url="^legacy$" />
          <action type="Redirect" url="/Default.aspx" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <location path="old">
    <system.webServer>
      <httpRedirect enabled="true" destination="/new" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="docs">
    <system.webServer>
      <defaultDocument>
        <files>
          <clear />
          <add value="home.aspx" />
        </files>
      </defaultDocument>
    </system.webServer>
  </location>
  <location path="replace">
    <system.webServer>
      <!-- ASP.NET sets TrySkipIisCustomErrors on its error pages, which existingResponse="Auto" passes through. -->
      <httpErrors existingResponse="Replace" />
    </system.webServer>
  </location>
  <location path="outbound">
    <system.webServer>
      <rewrite>
        <outboundRules>
          <preConditions>
            <preCondition name="IsHtml">
              <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
            </preCondition>
          </preConditions>
          <rule name="OldLinks" preCondition="IsHtml">
            <match filterByTags="A, Img" pattern="^/old-(link|img)/(.*)" />
            <action type="Rewrite" value="/new-{R:1}/{R:2}" />
          </rule>
          <rule name="Token" preCondition="IsHtml">
            <match pattern="OUTBOUND-TOKEN" />
            <action type="Rewrite" value="replaced-token" />
          </rule>
          <rule name="AppHeader">
            <match serverVariable="RESPONSE_X_App" pattern="(.+)" />
            <action type="Rewrite" value="outbound-{R:1}" />
          </rule>
        </outboundRules>
      </rewrite>
    </system.webServer>
  </location>
  <location path="browse">
    <system.webServer>
      <directoryBrowse enabled="true" />
    </system.webServer>
  </location>
  <location path="iprestricted">
    <system.webServer>
      <security>
        <ipSecurity allowUnlisted="false">
          <add ipAddress="10.0.0.0" subnetMask="255.0.0.0" allowed="true" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="ipallowed">
    <system.webServer>
      <security>
        <ipSecurity allowUnlisted="false" denyAction="NotFound">
          <add ipAddress="127.0.0.1" allowed="true" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="proxied">
    <system.webServer>
      <security>
        <ipSecurity enableProxyMode="true">
          <add ipAddress="203.0.113.0" subnetMask="24" allowed="false" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="ratelimited">
    <system.webServer>
      <security>
        <dynamicIpSecurity>
          <denyByRequestRate enabled="true" maxRequests="3" requestIntervalInMilliseconds="10000" />
        </dynamicIpSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="signalr">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- The root's maxQueryString="100" (a request filtering test) is too short for SignalR's connection token. -->
          <requestLimits maxQueryString="2048" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="ScriptResource.axd">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- ... and for ScriptResource.axd's encrypted resource names (ajax/Panel.aspx). -->
          <requestLimits maxQueryString="2048" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="slow">
    <system.web>
      <httpRuntime executionTimeout="2" />
    </system.web>
  </location>
  <location path="members">
    <system.webServer>
      <security>
        <authorization>
          <add accessType="Deny" users="?" />
        </authorization>
      </security>
    </system.webServer>
  </location>
</configuration>
