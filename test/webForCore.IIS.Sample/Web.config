<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- ADO.NET providers, as machine.config and web.config declared them on .NET Framework (data/Providers.aspx). -->
  <system.data>
    <DbProviderFactories>
      <add name="Gate provider" invariant="WebForCore.Gate" description="A provider declared by the application" type="IISSample.GateDbProviderFactory, webForCore.IIS.Sample" />
      <remove invariant="System.Data.OleDb" />
    </DbProviderFactories>
  </system.data>
  <!-- App_Code/CatalogData.xsd's TableAdapters (data/TypedDataSet.aspx): the SQL Server tools/lift/sqlserver.sh starts. -->
  <connectionStrings>
    <add name="CatalogConnectionString" connectionString="Data Source=127.0.0.1,14333;Initial Catalog=WebForCoreCatalog;User ID=sa;Password=webForCore-Test1!;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.net>
    <!-- The proxy of HttpClient and WebClient (net/Proxy.aspx); the gate runs one on this port. -->
    <defaultProxy>
      <proxy proxyaddress="http://127.0.0.1:31280" bypassonlocal="true" />
      <bypasslist>
        <add address="skip\.example\.invalid" />
      </bypasslist>
    </defaultProxy>
    <!-- System.Web's mail senders (mail/Send.aspx, mail/Recover.aspx); the gate runs an SMTP server on this port. -->
    <mailSettings>
      <smtp from="noreply@example.com">
        <network host="127.0.0.1" port="2525" />
      </smtp>
    </mailSettings>
  </system.net>
  <system.web>
    <!-- debug="false": ASP.NET times requests out (executionTimeout) only without debugging. -->
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <customErrors mode="Off" />
    <!-- How long an old domain's requests may run after a restart before they are aborted (default 30 s); short, so
         the gate sees it (AppDomainTests.RestartAbortsAWebSocketAfterTheShutdownTimeout). -->
    <hostingEnvironment shutdownTimeout="5" />
    <!-- A member for the login controls that send mail (mail/Recover.aspx). -->
    <membership defaultProvider="Gate">
      <providers>
        <clear />
        <add name="Gate" type="IISSample.GateMembershipProvider" />
      </providers>
    </membership>
  </system.web>
  <system.webServer>
    <modules>
      <!-- A managed module registered the integrated-mode way, and one of ASP.NET's removed. -->
      <add name="GateModule" type="GateModule" />
      <add name="IntegratedModule" type="IntegratedModule" />
      <remove name="Session" />
    </modules>
    <handlers>
      <add name="GateHandler" path="gate.axd" verb="GET,HEAD" type="GateHandler" />
    </handlers>
    <httpProtocol>
      <customHeaders>
        <add name="X-Gate-Header" value="iis" />
      </customHeaders>
      <redirectHeaders>
        <add name="X-Gate-Redirect" value="yes" />
      </redirectHeaders>
    </httpProtocol>
    <security>
      <requestFiltering>
        <fileExtensions>
          <add fileExtension=".secret" allowed="false" />
        </fileExtensions>
        <hiddenSegments>
          <add segment="private" />
        </hiddenSegments>
        <verbs>
          <add verb="TRACE" allowed="false" />
        </verbs>
        <denyUrlSequences>
          <add sequence="forbidden-sequence" />
        </denyUrlSequences>
        <requestLimits maxQueryString="100" />
      </requestFiltering>
    </security>
    <staticContent>
      <mimeMap fileExtension=".gate" mimeType="text/x-gate" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="1.00:00:00" />
    </staticContent>
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="errors\404.htm" responseMode="File" />
      <error statusCode="404" subStatusCode="7" path="errors\denied.htm" responseMode="File" />
      <error statusCode="500" path="/Error.aspx" responseMode="ExecuteURL" />
    </httpErrors>
    <rewrite>
      <rules>
        <rule name="Products">
          <match url="^products/([0-9]+)$" />
          <action type="Rewrite" url="Product.aspx?id={R:1}" />
        </rule>
        <rule name="Legacy" stopProcessing="true">
          <match url="^legacy$" />
          <action type="Redirect" url="/Default.aspx" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
  <location path="old">
    <system.webServer>
      <httpRedirect enabled="true" destination="/new" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <location path="docs">
    <system.webServer>
      <defaultDocument>
        <files>
          <clear />
          <add value="home.aspx" />
        </files>
      </defaultDocument>
    </system.webServer>
  </location>
  <location path="replace">
    <system.webServer>
      <!-- ASP.NET sets TrySkipIisCustomErrors on its error pages, which existingResponse="Auto" passes through. -->
      <httpErrors existingResponse="Replace" />
    </system.webServer>
  </location>
  <location path="outbound">
    <system.webServer>
      <rewrite>
        <outboundRules>
          <preConditions>
            <preCondition name="IsHtml">
              <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
            </preCondition>
          </preConditions>
          <rule name="OldLinks" preCondition="IsHtml">
            <match filterByTags="A, Img" pattern="^/old-(link|img)/(.*)" />
            <action type="Rewrite" value="/new-{R:1}/{R:2}" />
          </rule>
          <rule name="Token" preCondition="IsHtml">
            <match pattern="OUTBOUND-TOKEN" />
            <action type="Rewrite" value="replaced-token" />
          </rule>
          <rule name="AppHeader">
            <match serverVariable="RESPONSE_X_App" pattern="(.+)" />
            <action type="Rewrite" value="outbound-{R:1}" />
          </rule>
        </outboundRules>
      </rewrite>
    </system.webServer>
  </location>
  <location path="browse">
    <system.webServer>
      <directoryBrowse enabled="true" />
    </system.webServer>
  </location>
  <location path="iprestricted">
    <system.webServer>
      <security>
        <ipSecurity allowUnlisted="false">
          <add ipAddress="10.0.0.0" subnetMask="255.0.0.0" allowed="true" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="ipallowed">
    <system.webServer>
      <security>
        <ipSecurity allowUnlisted="false" denyAction="NotFound">
          <add ipAddress="127.0.0.1" allowed="true" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="proxied">
    <system.webServer>
      <security>
        <ipSecurity enableProxyMode="true">
          <add ipAddress="203.0.113.0" subnetMask="24" allowed="false" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="ratelimited">
    <system.webServer>
      <security>
        <dynamicIpSecurity>
          <denyByRequestRate enabled="true" maxRequests="3" requestIntervalInMilliseconds="10000" />
        </dynamicIpSecurity>
      </security>
    </system.webServer>
  </location>
  <location path="signalr">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- The root's maxQueryString="100" (a request filtering test) is too short for SignalR's connection token. -->
          <requestLimits maxQueryString="2048" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="ScriptResource.axd">
    <system.webServer>
      <security>
        <requestFiltering>
          <!-- ... and for ScriptResource.axd's encrypted resource names (ajax/Panel.aspx). -->
          <requestLimits maxQueryString="2048" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
  <location path="slow">
    <system.web>
      <httpRuntime executionTimeout="2" />
    </system.web>
  </location>
  <location path="members">
    <system.webServer>
      <security>
        <authorization>
          <add accessType="Deny" users="?" />
        </authorization>
      </security>
    </system.webServer>
  </location>
</configuration>
