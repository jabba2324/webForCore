<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Distributed rules: matched against the URL relative to /shop/; a relative URL is relative to /shop/. -->
    <rewrite>
      <rules>
        <rule name="ShopItem">
          <match url="^item/([0-9]+)$" />
          <action type="Rewrite" url="Item.aspx?id={R:1}" />
        </rule>
        <rule name="ShopHome" stopProcessing="true">
          <match url="^home$" />
          <action type="Redirect" url="/Default.aspx" redirectType="Found" />
        </rule>
        <rule name="ShopProduct">
          <match url="^p/([0-9]+)$" />
          <action type="Rewrite" url="/Product.aspx?id={R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
