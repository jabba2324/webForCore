<?xml version="1.0" encoding="utf-8"?>
<!-- RegressionTests (#10, #11): URL Rewrite rules ASP.NET Core's parser doesn't read as they are. Before, the first
     rule (IIS's own "Remove WWW" template) made webForCore drop every rule of this level, the blocking ones included;
     MiniBlog's rules looked like these. -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
    <rewrite>
      <rules>
        <rule name="Remove WWW" patternSyntax="Wildcard" stopProcessing="true">
          <match url="*" />
          <conditions>
            <add input="{CACHE_URL}" pattern="*://www.*" />
          </conditions>
          <action type="Redirect" url="{C:1}://{C:2}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Block wildcard" patternSyntax="Wildcard" stopProcessing="true">
          <match url="private-*.txt" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="Block exact" patternSyntax="ExactMatch" stopProcessing="true">
          <match url="exact.txt" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
        <rule name="slug" stopProcessing="true">
          <match url="^post/(.*)" ignoreCase="true" />
          <action type="Rewrite" url="?slug={R:1}" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
