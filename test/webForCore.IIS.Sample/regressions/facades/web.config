<?xml version="1.0" encoding="utf-8"?>
<!-- #20: the <compilation><assemblies> entries of an MVC 2-4 web.config (Roadkill's). On .NET Framework 4 both are
     facades in the GAC that forward to System.Web. -->
<configuration>
  <system.web>
    <compilation>
      <assemblies>
        <add assembly="System.Web.Abstractions, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
        <add assembly="System.Web.Routing, Version=4.0.0.0, Culture=neutral, PublicKeyToken=31BF3856AD364E35" />
      </assemblies>
    </compilation>
  </system.web>
</configuration>
