<?xml version="1.0" encoding="utf-8"?>
<!-- Pages for IIS.Gate.Tests' RegressionTests: one per fixed issue, each named after what it exercises. -->
<configuration>
  <configSections>
    <!-- #19: a section handler reached through the System facade (ELMAH's derive from SingleTagSectionHandler in
         System, Version=2.0.0.0). -->
    <section name="regressionsSingleTag" type="System.Configuration.SingleTagSectionHandler, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
    <!-- #154: the sections Visual Studio writes for a settings class (ApplicationSettings.aspx). -->
    <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Regressions.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
      <section name="Regressions.Properties.UserSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
    </sectionGroup>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
      <section name="Regressions.Properties.UserSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <regressionsSingleTag probe="from SingleTagSectionHandler" />
  <appSettings>
    <add key="regressions:probe" value="from regressions/web.config" />
  </appSettings>
  <applicationSettings>
    <Regressions.Properties.Settings>
      <setting name="ServiceUrl" serializeAs="String">
        <value>http://our.umbraco.org/umbraco/webservices/api/repository.asmx</value>
      </setting>
      <setting name="Retries" serializeAs="String">
        <value>3</value>
      </setting>
    </Regressions.Properties.Settings>
    <Regressions.Properties.UserSettings>
      <setting name="AppValue" serializeAs="String">
        <value>app from web.config</value>
      </setting>
    </Regressions.Properties.UserSettings>
  </applicationSettings>
  <userSettings>
    <Regressions.Properties.UserSettings>
      <setting name="UserValue" serializeAs="String">
        <value>user from web.config</value>
      </setting>
    </Regressions.Properties.UserSettings>
  </userSettings>
</configuration>
