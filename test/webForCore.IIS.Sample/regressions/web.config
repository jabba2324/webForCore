<?xml version="1.0" encoding="utf-8"?>
<!-- Pages for IIS.Gate.Tests' RegressionTests: one per fixed issue, each named after what it exercises. -->
<configuration>
  <configSections>
    <!-- #19: a section handler reached through the System facade (ELMAH's derive from SingleTagSectionHandler in
         System, Version=2.0.0.0). -->
    <section name="regressionsSingleTag" type="System.Configuration.SingleTagSectionHandler, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" />
  </configSections>
  <regressionsSingleTag probe="from SingleTagSectionHandler" />
  <appSettings>
    <add key="regressions:probe" value="from regressions/web.config" />
  </appSettings>
</configuration>
