<?xml version="1.0" encoding="utf-8"?>
<!-- RegressionTests (#10): rules webForCore can't use (a request header as a server variable, which IIS reads and
     ASP.NET Core's parser doesn't) must fail closed. They used to be dropped, so blocked.txt was served. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Header" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTP_X_REGRESSIONS_UNKNOWN}" pattern="^yes$" />
          </conditions>
          <action type="AbortRequest" />
        </rule>
        <rule name="Block" stopProcessing="true">
          <match url="^blocked\.txt$" />
          <action type="CustomResponse" statusCode="403" statusReason="Forbidden" statusDescription="Forbidden" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
