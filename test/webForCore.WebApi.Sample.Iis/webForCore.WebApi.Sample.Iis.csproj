<Project Sdk="Microsoft.NET.Sdk">

  <!-- test/webForCore.WebApi.Sample for IIS 10 and .NET Framework 4.8 (#78): the same source files, Global.asax and
       Web.config, built against Microsoft's NuGet packages of Web API 2 and Katana instead of webForCore's. CI's
       iis-compare job (windows-2025) serves it from IIS in a classic-pipeline application pool and sends it the
       requests that WebApi.Gate.Tests recorded on Kestrel (gate-responses.json); tools/ci/iis_compare.cs diffs the two.
       Not in WebFormsForCore.slnx: only that job builds it. It builds on Linux too (reference assemblies).

       The site is written to $(IisSiteDirectory) (obj/site by default): Global.asax, the sample's Web.config with the
       binding redirects the packages need (as NuGet writes them into a Visual Studio project's Web.config), and bin. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>webForCore.WebApi.Sample</AssemblyName>
    <RootNamespace>WebApiSample</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <IisSiteDirectory Condition="'$(IisSiteDirectory)' == ''">$(MSBuildProjectDirectory)\obj\site\</IisSiteDirectory>
    <Sample>$(MSBuildProjectDirectory)\..\webForCore.WebApi.Sample\</Sample>
  </PropertyGroup>

  <ItemGroup>
    <!-- Program.cs is the Kestrel entry point; IIS starts the application from Global.asax. -->
    <Compile Include="$(Sample)**\*.cs" Exclude="$(Sample)Program.cs;$(Sample)bin_dotnet\**;$(Sample)obj\**;$(Sample)bin\**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Web" />
    <Reference Include="System.ComponentModel.DataAnnotations" />
    <PackageReference Include="Microsoft.AspNet.WebApi.WebHost" Version="5.3.0" />
    <PackageReference Include="Microsoft.AspNet.WebApi.Owin" Version="5.3.0" />
    <PackageReference Include="Microsoft.Owin.Host.SystemWeb" Version="4.2.3" />
  </ItemGroup>

  <UsingTask TaskName="WebForCoreIisWebConfig" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <WebConfig ParameterType="System.String" Required="true" />
      <AssemblyConfig ParameterType="System.String" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // The sample's Web.config plus the <runtime> (assembly binding redirects) the build generated for the packages.
        XDocument config = XDocument.Load(WebConfig);
        config.Root.Elements("runtime").Remove();
        if (File.Exists(AssemblyConfig))
        {
            XElement runtime = XDocument.Load(AssemblyConfig).Root.Element("runtime");
            if (runtime != null) config.Root.Add(runtime);
        }
        Directory.CreateDirectory(Path.GetDirectoryName(Output));
        config.Save(Output);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WriteIisSite" AfterTargets="Build">
    <ItemGroup>
      <_IisBin Include="$(OutDir)*.dll;$(OutDir)*.pdb;$(OutDir)*.xml" />
    </ItemGroup>
    <Copy SourceFiles="@(_IisBin)" DestinationFolder="$(IisSiteDirectory)bin" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(Sample)Global.asax" DestinationFolder="$(IisSiteDirectory)" SkipUnchangedFiles="true" />
    <WebForCoreIisWebConfig WebConfig="$(Sample)Web.config" AssemblyConfig="$(TargetPath).config" Output="$(IisSiteDirectory)Web.config" />
    <Message Importance="high" Text="IIS site: $(IisSiteDirectory)" />
  </Target>
</Project>
