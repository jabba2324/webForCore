<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- As in the Visual Studio "MVC" template. -->
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- A cookie name of its own: session state through UseAspNetCoreSessionProvider() must use it, and set no other
         session cookie (GateTests.OneSessionCookie, #79). -->
    <sessionState cookieName="MvcSample_SessionId" />
  </system.web>
  <!-- #192: HandleErrorAttribute needs customErrors on (ErrorsController). -->
  <location path="Errors">
    <system.web>
      <customErrors mode="On" defaultRedirect="~/Errors/Page">
        <error statusCode="404" redirect="~/Errors/Page" />
      </customErrors>
    </system.web>
  </location>
  <location path="ErrorsOff">
    <system.web>
      <customErrors mode="Off" />
    </system.web>
  </location>
</configuration>

