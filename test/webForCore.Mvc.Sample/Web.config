<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- As in the Visual Studio "MVC" template. -->
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <connectionStrings>
    <!-- NotesController: LINQ to SQL with a rowversion (#142), against the SQL Server of the other data tests
         (127.0.0.1,14333: tools/ci/sqlserver.sh, or SQL Server Express on Windows: tools/ci/sqlserver-windows.ps1). -->
    <add name="Notes" connectionString="Data Source=127.0.0.1,14333;Initial Catalog=WebForCoreMvcLinqGate;User ID=sa;Password=webForCore-Test1!;TrustServerCertificate=True" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- A cookie name of its own: session state through UseAspNetCoreSessionProvider() must use it, and set no other
         session cookie (GateTests.OneSessionCookie, #79). -->
    <sessionState cookieName="MvcSample_SessionId" />
  </system.web>
</configuration>
