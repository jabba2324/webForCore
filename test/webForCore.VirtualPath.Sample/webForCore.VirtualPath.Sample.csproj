<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- An application under a virtual path (#190) and behind a reverse proxy (#194): Web Forms pages, MVC and Web API
       routes, bundles, forms authentication and session state, in an application at /app rather than at the site's root
       (UseWebForms(o => o.VirtualPath("/app"))), as IIS runs an application under a site. Program.cs is the Kestrel entry
       point; IIS starts the application from Global.asax. test/webForCore.IIS.Gate.Tests (VirtualPathTests,
       ForwardedHeadersTests) drives it and records each response in vpath-responses.json; CI's iis-compare job builds the
       same files for .NET Framework 4.8 (test/webForCore.VirtualPath.Sample.Iis), serves them from IIS 10 as the
       application /app of a site, and diffs the two (tools/ci/iis_compare.cs). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The fork serves the parent of the output folder (WebFormsMiddleware: PhysicalPath), as in the TestApp. -->
    <OutputPath>bin_dotnet</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>true</GenerateDependencyFile>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <Import Project="..\..\src\webForCore.WebStack.targets" />

  <ItemGroup>
    <Content Remove="bin_dotnet\**" />
    <None Remove="bin_dotnet\**" />
    <Compile Remove="bin_dotnet\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WebFormsForCore.Configuration\WebFormsForCore.Configuration.csproj" />
    <PackageReference Include="drawingForCore" Version="$(DrawingForCoreVersion)" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Serialization.Formatters\WebFormsForCore.Serialization.Formatters.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web\WebFormsForCore.Web.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.ApplicationServices\WebFormsForCore.Web.ApplicationServices.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.RegularExpressions\WebFormsForCore.Web.RegularExpressions.csproj" />
    <!-- The fork's machine.config is .NET Framework's root configuration: <compilation><assemblies> lists System.Web.Services
         and <httpModules> has System.Web.Extensions' ScriptModule. On .NET Framework they are in the GAC; here the app
         deploys them. -->
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Services\WebFormsForCore.Web.Services.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Extensions\WebFormsForCore.Web.Extensions.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Infrastructure\WebFormsForCore.Web.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Compilers\WebFormsForCore.Compilers.csproj" />
    <ProjectReference Include="..\..\src\WebFormsForCore.Web.Optimization\WebFormsForCore.Web.Optimization.csproj" />
    <ProjectReference Include="..\..\src\webForCore.System.Web.Mvc\webForCore.System.Web.Mvc.csproj" />
    <ProjectReference Include="..\..\src\webForCore.System.Web.Http.WebHost\webForCore.System.Web.Http.WebHost.csproj" />
    <!-- Swashbuckle 5 (Swagger for Web API 2), a test-only reference: its documents' root URL (#190). -->
    <PackageReference Include="Swashbuckle.Core" Version="5.6.0" />
    <!-- Its dependency on Microsoft's Web API package, whose assemblies webForCore's replace (the webForCore packages do this
         for an application: webForCore.WebStack.targets; the projects here are referenced as projects). -->
    <PackageReference Include="Microsoft.AspNet.WebApi.Core" Version="4.0.20710" ExcludeAssets="all" />
  </ItemGroup>
</Project>
