<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <!-- As in the Visual Studio "MVC" template. -->
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- requireSSL: the forms cookie is issued, and read, only on a request the application sees as secure (#194). -->
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login.aspx" defaultUrl="~/Probe.aspx" requireSSL="true" />
    </authentication>
  </system.web>
  <location path="Secure">
    <system.web>
      <authorization>
        <deny users="?" />
      </authorization>
    </system.web>
  </location>
  <location path="Restricted">
    <!-- One client address, without enableProxyMode: REMOTE_ADDR (#194). Not sent to IIS by the comparison (IIS locks
         <ipSecurity> unless its role service is installed and the section unlocked). -->
    <system.webServer>
      <security>
        <ipSecurity allowUnlisted="false">
          <add ipAddress="203.0.113.7" allowed="true" />
        </ipSecurity>
      </security>
    </system.webServer>
  </location>
  <system.webServer>
    <modules>
      <!-- Sets REMOTE_ADDR and HTTPS from a header, as applications behind a proxy did on IIS (#194). -->
      <add name="ServerVariables" type="VirtualPathSample.ServerVariablesModule" />
    </modules>
    <handlers>
      <!-- As in the Visual Studio "Web API" template. -->
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*" type="System.Web.Handlers.TransferRequestHandler" preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>
</configuration>
