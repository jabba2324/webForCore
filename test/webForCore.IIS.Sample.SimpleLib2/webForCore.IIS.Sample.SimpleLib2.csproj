<Project Sdk="Microsoft.NET.Sdk">

  <!-- #171: SimpleLib 2.0.0.0, the same source as webForCore.IIS.Sample.SimpleLib (1.0.0.0). SimpleUser is built against
       it; the IIS sample deploys only 1.0.0.0. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SimpleLib</AssemblyName>
    <RootNamespace>SimpleLib</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <IsPackable>false</IsPackable>
    <OutputPath>bin_dotnet</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\webForCore.IIS.Sample.SimpleLib\Greeting.cs" />
  </ItemGroup>
</Project>
