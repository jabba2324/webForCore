<Project Sdk="Microsoft.NET.Sdk">

  <!-- From aspnet/AspNetWebStack 2106565 (System.Web.Http.Tracing.Test) by way of the external/AspNetWebStack submodule (xforcore/AspNetWebStack's webforcore branch, #61).
       Apache License 2.0; see LICENSE-APACHE-2.0.txt and NOTICE at the repo root. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Web.Http.Tracing.Test</AssemblyName>
    <RootNamespace>System.Web.Http.Tracing</RootNamespace>
    <PackageId>webForCore.Web.Http.Tracing.Test</PackageId>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <!-- Microsoft's build uses C# 9 (tools/WebStack.settings.targets). -->
    <LangVersion>9.0</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;CS0618;CS0612;SYSLIB0003;SYSLIB0011;SYSLIB0051</NoWarn>
    <!-- Delay signed with Microsoft's public key, as Microsoft's build does: PublicKeyToken=31bf3856ad364e35. -->
    <SignAssembly>true</SignAssembly>
    <DelaySign>true</DelaySign>
    <AssemblyOriginatorKeyFile>../../src/SigningKey/35MSSharedLib1024.snk</AssemblyOriginatorKeyFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <Import Project="../../src/webForCore.WebStack.targets" />

  <ItemGroup>
    <Compile Include="../../external/AspNetWebStack/test/System.Web.Http.Tracing.Test/HttpConfigurationTracingExtensionsTest.cs" Link="HttpConfigurationTracingExtensionsTest.cs" />
    <Compile Include="../../external/AspNetWebStack/test/System.Web.Http.Tracing.Test/SystemDiagnosticsTraceWriterTest.cs" Link="SystemDiagnosticsTraceWriterTest.cs" />
  </ItemGroup>

