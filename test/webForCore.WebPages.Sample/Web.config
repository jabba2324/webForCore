<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
    <!-- The site's IIS configuration: the ASP.NET State Service. Program.cs's UseAspNetCoreSessionProvider() takes its
         place; cookieName and timeout still apply. -->
    <sessionState mode="StateServer" stateConnectionString="tcpip=127.0.0.1:42424" cookieName="WebPagesSample_SessionId" />
  </system.web>
</configuration>
