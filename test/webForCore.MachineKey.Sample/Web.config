<?xml version="1.0" encoding="utf-8"?>
<!-- The sample run on its own (MachineKeyInteropTests writes a site with each configuration's Web.config instead):
     the hmacsha256-aes-targetframework45 configuration of Interop/MachineKeyConfigs.cs. -->
<configuration>
  <appSettings>
    <add key="interop:config" value="hmacsha256-aes-targetframework45" />
    <add key="owin:appStartup" value="MachineKeySample.Startup, webForCore.MachineKey.Sample" />
    <!-- The module is registered below: a configuration's site has no bin folder for Katana's PreApplicationStartMethod to be found in. -->
    <add key="owin:AutomaticAppStartup" value="false" />
  </appSettings>
  <system.web>
    <compilation debug="false" />
    <httpRuntime targetFramework="4.5" />
    <machineKey validationKey="0A1B2C3D4E5F60718293A4B5C6D7E8F90A1B2C3D4E5F60718293A4B5C6D7E8F9F9E8D7C6B5A4938271605F4E3D2C1B0AF9E8D7C6B5A4938271605F4E3D2C1B0A" decryptionKey="1F2E3D4C5B6A79880F1E2D3C4B5A69781F2E3D4C5B6A79880F1E2D3C4B5A6978" validation="HMACSHA256" decryption="AES" />
    <authentication mode="Forms">
      <forms />
    </authentication>
    <httpHandlers>
      <add path="interop.axd" verb="*" type="MachineKeySample.InteropHandler, webForCore.MachineKey.Sample" />
    </httpHandlers>
    <httpModules>
      <add name="OwinHttpModule" type="Microsoft.Owin.Host.SystemWeb.OwinHttpModule, Microsoft.Owin.Host.SystemWeb" />
    </httpModules>
  </system.web>
</configuration>
